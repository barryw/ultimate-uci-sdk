% ultimatesdk.sty - the look of a Commodore user's guide, in LaTeX.
%
% The 1982 Commodore 64 User's Guide is the model, and the things that make it
% recognisable are worth naming, because each one is a decision here:
%
%   - a blue divider page in front of every chapter, with a large numeral and
%     the chapter's contents as a bulleted list
%   - section headings in bold blue, set in a geometric sans
%   - listings shown as a C64 screen: light blue on dark blue, in the real
%     palette rather than an approximation
%   - keys drawn as keycaps, so RETURN reads as a key and not as a word
%   - warm, roomy body text on a narrow measure
%
% SPDX-License-Identifier: MIT

\ProvidesPackage{ultimatesdk}[2026/08/18 Ultimate SDK guide style]

\RequirePackage[T1]{fontenc}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{eso-pic}
\RequirePackage{tcolorbox}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{microtype}
\RequirePackage{needspace}
\tcbuselibrary{skins,breakable}

% ---------------------------------------------------------------------------
% Colour.
%
% The screen colours are the C64's own palette, not a guess: background and
% text are the values a real machine powers up with, so a listing in this book
% is the colour it will be on the screen in front of you. The heading blue is
% the printer's ink from the guide, which is a brighter corporate blue and
% deliberately not the screen colour.
% ---------------------------------------------------------------------------
\definecolor{c64screen}{HTML}{40318D}   % the power-on background
\definecolor{c64border}{HTML}{6C5EB5}   % and its border
% The screen's own light blue is #7B71D6, and on paper it is too close to the
% background to read comfortably. This is the same hue lifted for print - the
% one place in this file where legibility beats authenticity.
\definecolor{c64text}{HTML}{B4ACF5}
\definecolor{guideblue}{HTML}{0069B4}   % the ink the guide is printed in
\definecolor{guiderule}{HTML}{B9D9EE}
\definecolor{keycap}{HTML}{2B2B2B}
\definecolor{notegrey}{HTML}{F2F2F2}

% ---------------------------------------------------------------------------
% Type. URW Gothic for headings is as close to the guide's Kabel as anything
% that ships with TeX Live; the body is a humanist sans because the original
% is, and a reference book that is pleasant to read is half the job.
% ---------------------------------------------------------------------------
\RequirePackage{avant}
\RequirePackage[scaled=0.92]{helvet}
\RequirePackage[varqu,scaled=0.95]{inconsolata}
\renewcommand{\familydefault}{\sfdefault}
\newcommand{\headingfont}{\fontfamily{pag}\selectfont\bfseries}

\linespread{1.10}
\setlength{\parindent}{1.4em}
\setlength{\parskip}{0pt}

% ---------------------------------------------------------------------------
% Headings.
% ---------------------------------------------------------------------------
\titleformat{\section}
  {\headingfont\color{guideblue}\large}{}{0pt}{\MakeUppercase}
\titlespacing*{\section}{0pt}{2.2\baselineskip}{0.8\baselineskip}

\titleformat{\subsection}
  {\headingfont\color{guideblue}\normalsize}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{1.6\baselineskip}{0.5\baselineskip}

\titleformat{\subsubsection}[runin]
  {\headingfont\normalsize}{}{0pt}{}[\quad]
\titlespacing*{\subsubsection}{0pt}{1.1\baselineskip}{0.6em}

% ---------------------------------------------------------------------------
% Running heads and folios: page number centred at the foot, as in the guide.
% ---------------------------------------------------------------------------
\fancypagestyle{guide}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\footnotesize\color{black!70}\thepage}%
}
\pagestyle{guide}

% ---------------------------------------------------------------------------
% The chapter divider page.
%
% A whole blue leaf, the numeral large and to the right, the title under it,
% then what the chapter covers as a bulleted list - which doubles as a
% contents page for the chapter and is why the original is so easy to leaf
% through looking for something.
% ---------------------------------------------------------------------------
\newcounter{guidechapter}
\newcommand{\chaptercontents}{}

\newcommand{\guidechapter}[2]{%
  \clearpage
  \refstepcounter{guidechapter}%
  \thispagestyle{empty}%
  \AddToShipoutPictureBG*{\AtPageLowerLeft{%
    \color{guideblue}\rule{\paperwidth}{\paperheight}}}%
  \null\vspace*{0.16\paperheight}%
  {\color{white}\headingfont
   \begin{flushright}
     {\fontsize{16}{18}\selectfont CHAPTER\hspace{0.6em}}%
     {\fontsize{64}{64}\selectfont \theguidechapter}\\[2.2\baselineskip]
     {\fontsize{26}{30}\selectfont #1}
   \end{flushright}
   \vspace{1.6\baselineskip}
   \begin{flushright}
     \begin{minipage}{0.62\linewidth}
       \normalsize\normalfont\color{white}
       \begin{itemize}[leftmargin=1.2em,itemsep=0.15em,topsep=0pt,label={\textbullet}]
         #2
       \end{itemize}
     \end{minipage}
   \end{flushright}}%
  \clearpage
  \addcontentsline{toc}{chapter}{\protect\numberline{\theguidechapter}#1}%
}

% ---------------------------------------------------------------------------
% A C64 screen.
%
% Everything the reader is told to type, and everything the machine says back,
% is shown the way it looks on the screen: light blue on dark blue, inside the
% border. Uppercase is not a shouting style - it is what the machine displays.
% ---------------------------------------------------------------------------
\newtcolorbox{screen}[1][]{%
  enhanced,
  colback=c64screen, colframe=c64border,
  boxrule=3mm, arc=1mm, outer arc=1mm,
  left=3mm, right=3mm, top=2.5mm, bottom=2.5mm,
  before skip=1.1\baselineskip, after skip=1.1\baselineskip,
  fontupper=\ttfamily\color{c64text}\linespread{1.0}\selectfont,
  before upper={\catcode`\_=12\relax},
  #1}

% A listing of source you keep in a file rather than type at the machine: plain
% paper, a rule down the left, no screen furniture.
\newtcolorbox{listingbox}[1][]{%
  enhanced,
  colback=black!2, colframe=guideblue,
  boxrule=0pt, leftrule=1.6pt, arc=0pt, outer arc=0pt,
  left=3mm, right=3mm, top=2.2mm, bottom=2.2mm,
  before skip=1.0\baselineskip, after skip=1.0\baselineskip,
  fontupper=\ttfamily\small\linespread{1.05}\selectfont,
  % A trailing backslash in the chapter source tokenises as TeX's
  % control-space command.  Inside source listings it means newline.
  before upper={\catcode`\_=12\relax\def\ {\newline}},
  #1}

% Observable output or returned values from the listing immediately above.
% This is deliberately smaller than a full C64-screen illustration.
\newtcolorbox{outputbox}[1][]{%
  enhanced,
  title=OUTPUT,
  colback=c64screen, colframe=c64border,
  coltitle=c64text, colbacktitle=c64screen,
  boxrule=1.2mm, arc=1mm, outer arc=1mm,
  left=3mm, right=3mm, top=1.5mm, bottom=1.5mm,
  before skip=0.5\baselineskip, after skip=1.0\baselineskip,
  before={\par\nopagebreak[4]\noindent},
  fonttitle=\sffamily\bfseries\small,
  fontupper=\ttfamily\small\color{c64text}\linespread{1.0}\selectfont,
  before upper={\catcode`\_=12\relax},
  #1}

% ---------------------------------------------------------------------------
% A keycap, so RETURN reads as a key.
% ---------------------------------------------------------------------------
\newcommand{\key}[1]{%
  \tikz[baseline=(K.base)]{
    \node[fill=keycap, text=white, rounded corners=1.2pt,
          inner xsep=3.5pt, inner ysep=1.6pt,
          font=\sffamily\bfseries\scriptsize] (K) {\MakeUppercase{#1}};}}

% ---------------------------------------------------------------------------
% A note, and a warning. The guide sets NOTE: in italic and indents the
% paragraph; the warning is the same shape with the ink turned up, and is used
% only where getting it wrong costs the reader real time.
% ---------------------------------------------------------------------------
\newenvironment{note}
  {\par\vspace{0.7\baselineskip}\noindent
   \begin{tcolorbox}[enhanced, breakable, colback=notegrey, colframe=notegrey,
     boxrule=0pt, leftrule=2pt, coltitle=black,
     borderline west={2pt}{0pt}{guideblue},
     arc=0pt, outer arc=0pt, left=3mm, right=3mm, top=2mm, bottom=2mm]
   \small\textit{Note:}\hspace{0.4em}}
  {\end{tcolorbox}\par\vspace{0.3\baselineskip}}

\newenvironment{warning}
  {\par\vspace{0.7\baselineskip}\noindent
   \begin{tcolorbox}[enhanced, breakable, colback=red!4, colframe=red!4,
     boxrule=0pt, arc=0pt, outer arc=0pt,
     borderline west={2pt}{0pt}{red!60!black},
     left=3mm, right=3mm, top=2mm, bottom=2mm]
   \small\textbf{Careful:}\hspace{0.4em}}
  {\end{tcolorbox}\par\vspace{0.3\baselineskip}}

% ---------------------------------------------------------------------------
% Small conveniences used throughout the text.
% ---------------------------------------------------------------------------
\newcommand{\sdk}{\textbf{ULTIMATE SDK}}
\newcommand{\ult}{\textbf{ULTIMATE 64}}
% An identifier or a path, set in the monospace face. The SDK's names are long
% - ultimate_http_body_binary is 26 characters - and several are wider than
% what is left of a line on a six-inch page, which put them into the margin.
% A break is allowed after each underscore and each slash, so a name that does
% not fit can be split where a reader expects one to split. No hyphen is added:
% a hyphen inside an identifier would look like part of the name.
\newcommand{\cmd}[1]{{\ttfamily\def\_{\textunderscore\allowbreak}#1}}
\newcommand{\bas}[1]{\texttt{\MakeUppercase{#1}}}

% A two-column table of things and what they do, used for keyword and entry
% point summaries. Plain, ruled only under the head, as the guide's are.
\RequirePackage{booktabs}
\RequirePackage{array}
\newenvironment{reftable}[1]
  {\par\vspace{0.5\baselineskip}\small
   \begin{tabular}{@{}#1@{}}\toprule}
  {\bottomrule\end{tabular}\par\vspace{0.7\baselineskip}}

% ---------------------------------------------------------------------------
% The covers.
%
% The 1982 guide's cover is four things stacked, and each one is a piece here:
%
%   - a purple-to-blue field with a chart grid ruled across it and a couple of
%     bright plot lines running over the grid
%   - the masthead in heavy white caps, with the part that names the machine
%     set larger and in two-tone colour blocks
%   - the computer itself lying across the lower third at a slight tilt
%   - a band of blue stripes along the foot, thinning as they descend, with
%     the logo sitting in the clear paper below them
%
% All four are drawn rather than photographed, so the book still builds from a
% clean checkout with nothing beside it. The canvas is 100 units wide and the
% unit is a hundredth of the page width in *both* directions, which keeps the
% drawing square: a 6 x 9 page is 100 by 150.
% ---------------------------------------------------------------------------
\RequirePackage{graphicx}
\usetikzlibrary{shadings}

% The field. Deep violet at the top, warming through the middle, blue at the
% lower right - the original is a photographed gradient and this is the same
% four corners.
\definecolor{coverdeep}{HTML}{412268}
\definecolor{coverpurple}{HTML}{3B2C7C}
\definecolor{covermid}{HTML}{7A5AA8}
\definecolor{coverblue}{HTML}{2E6FB0}
\definecolor{covergrid}{HTML}{9CC3E6}

% The plot lines over the grid.
\definecolor{chartlime}{HTML}{C4D93F}
\definecolor{chartgreen}{HTML}{6FBF4A}
\definecolor{chartcoral}{HTML}{F07A3C}
\definecolor{chartrose}{HTML}{E24A8B}

% The masthead blocks: the flat, saturated inks of the original's numerals.
\definecolor{blockmagenta}{HTML}{D62A7C}
\definecolor{blockorange}{HTML}{F2762E}
\definecolor{blockyellow}{HTML}{F4CE2A}
\definecolor{blockgreen}{HTML}{45B449}
\definecolor{blockred}{HTML}{E03A3E}
\definecolor{blockviolet}{HTML}{7B3FA0}

% The foot: stock paper, stripe blue, and the wordmark ink.
\definecolor{coverpaper}{HTML}{F4EFE3}
\definecolor{stripeblue}{HTML}{5B9BD5}
\definecolor{logoblue}{HTML}{343488}

% The machine. Commodore's beige in three values - top, front, and the side
% that is turned away from the light.
\definecolor{c64top}{HTML}{D5C9AC}
\definecolor{c64front}{HTML}{BCAF92}
\definecolor{c64side}{HTML}{97896F}
\definecolor{c64key}{HTML}{4A4038}
\definecolor{c64fkey}{HTML}{B08D6A}

\newcommand{\mastheadfont}{\fontfamily{pag}\bfseries}

% A whole page given over to one drawing. The body of the argument is TikZ,
% drawn on the 100-unit canvas described above.
\newcommand{\coverpicture}[1]{%
  \clearpage
  \thispagestyle{empty}%
  \AddToShipoutPictureBG*{\AtPageLowerLeft{%
    \begin{tikzpicture}[x=0.01\paperwidth,y=0.01\paperwidth,
                        inner sep=0pt,line join=round,line cap=round]
      #1
    \end{tikzpicture}}}%
  \null\clearpage}

% The gradient field, from the top of the stripe band to the head of the page.
\newcommand{\coverfield}{%
  \shade[upper left=coverdeep,  upper right=coverpurple,
         lower left=covermid,   lower right=coverblue]
    (0,34) rectangle (100,150);}

% The chart grid, ruled between two heights and clipped to them.
\newcommand{\covergridlines}[2]{%
  \begin{scope}
    \clip (0,#1) rectangle (100,#2);
    \foreach \g in {0,6,...,150}
      \draw[covergrid,opacity=0.26,line width=0.4pt] (0,\g) -- (100,\g);
    \foreach \g in {-4,4,...,104}
      \draw[covergrid,opacity=0.26,line width=0.4pt] (\g,#1) -- (\g,#2);
  \end{scope}}

% The band at the foot: paper, then seven stripes that thin as they fall, then
% a last full-width rule along the very bottom edge.
\newcommand{\coverband}{%
  \fill[coverpaper] (0,0) rectangle (100,34);
  \foreach \ty/\tw in {30.9/2.6, 27.5/2.3, 24.5/2.0, 21.9/1.7,
                       19.7/1.4, 17.9/1.1, 16.5/0.8}
    \fill[stripeblue] (0,\ty) rectangle (100,{\ty+\tw});
  \fill[stripeblue] (0,0) rectangle (100,1.6);}

% The wordmark, centred on #1 with both weights sharing the baseline at #2.
\newcommand{\coverlogo}[2]{%
  \node[anchor=base,text=logoblue,
        font=\fontfamily{pag}\fontsize{17}{17}\selectfont]
       at (#1,#2) {{\bfseries ultimate}\hspace{0.55em}{\mdseries SDK}};}

% A masthead letter in two tones: the glyph in one colour, then its lower
% right half clipped away and drawn again in a second. This is what gives the
% original's numerals their look, and it costs two nodes.
\newcommand{\blockletter}[5]{%
  \node[anchor=base west,text=#4,
        font=\mastheadfont\fontsize{56}{56}\selectfont] (bl#3) at (#1,#2) {#3};
  \begin{scope}
    \clip (bl#3.south west) -- (bl#3.south east) -- (bl#3.north east) -- cycle;
    \node[anchor=base west,text=#5,
          font=\mastheadfont\fontsize{56}{56}\selectfont] at (#1,#2) {#3};
  \end{scope}}

% ---------------------------------------------------------------------------
% The machine.
%
% A flat three-quarter view rather than a photograph: a top face sheared back
% and to the right, a front face under it, and the one side the view can see.
% The keyboard is laid out in the top face's own coordinates, so the keys sit
% in the shear with it and nothing has to be drawn twice.
%
% Local coordinates: the body is 62 wide and 5.2 tall at the front, and the
% top face runs back along (13, 9.5). The caller positions and tilts it.
% ---------------------------------------------------------------------------
\newcommand{\covermachine}{%
  % (u,v) on the top face, u across the keyboard and v towards the back.
  \def\tp##1##2{({(##1)*62+(##2)*13},{5.2+(##2)*9.5})}%
  % The side that is turned away, then the front, then the top.
  \fill[c64side]  (62,0) -- (75,9.5) -- (75,14.7) -- (62,5.2) -- cycle;
  \fill[c64front] (0,0) -- (62,0) -- (62,5.2) -- (0,5.2) -- cycle;
  \fill[c64front!85!black] (0,0) rectangle (62,0.9);
  \fill[c64top]   \tp{0}{0} -- \tp{1}{0} -- \tp{1}{1} -- \tp{0}{1} -- cycle;
  % A shadow line where the top face meets the front, so the two read apart.
  \draw[c64side,line width=0.3pt] \tp{0}{0} -- \tp{1}{0};
  % The keyboard: five rows of fifteen, less the bottom row, which is the
  % space bar with a few keys either side of it.
  \foreach \ky in {1,2,3,4}
    \foreach \kx in {0,...,14} {
      \fill[c64key]
        \tp{0.030+\kx*0.0507}{0.120+\ky*0.160} --
        \tp{0.030+\kx*0.0507+0.0405}{0.120+\ky*0.160} --
        \tp{0.030+\kx*0.0507+0.0405}{0.120+\ky*0.160+0.115} --
        \tp{0.030+\kx*0.0507}{0.120+\ky*0.160+0.115} -- cycle;}
  \foreach \kx in {0,1} {
      \fill[c64key]
        \tp{0.030+\kx*0.0507}{0.120} -- \tp{0.030+\kx*0.0507+0.0405}{0.120} --
        \tp{0.030+\kx*0.0507+0.0405}{0.235} -- \tp{0.030+\kx*0.0507}{0.235} -- cycle;}
  \fill[c64key] \tp{0.132}{0.120} -- \tp{0.640}{0.120}
                -- \tp{0.640}{0.235} -- \tp{0.132}{0.235} -- cycle;
  \foreach \kx in {13,14} {
      \fill[c64key]
        \tp{0.030+\kx*0.0507}{0.120} -- \tp{0.030+\kx*0.0507+0.0405}{0.120} --
        \tp{0.030+\kx*0.0507+0.0405}{0.235} -- \tp{0.030+\kx*0.0507}{0.235} -- cycle;}
  % The four function keys, in their lighter brown, stacked at the right.
  \foreach \ky in {0,1,2,3} {
      \fill[c64fkey]
        \tp{0.830}{0.130+\ky*0.192} -- \tp{0.945}{0.130+\ky*0.192} --
        \tp{0.945}{0.130+\ky*0.192+0.140} -- \tp{0.830}{0.130+\ky*0.192+0.140} -- cycle;}
  % The badge on the front face, right of the keyboard.
  \fill[c64side] (53.5,1.9) rectangle (60.0,3.6);}

\endinput
