# Linker config for the standalone SDK blob.
#
# Three areas: the jump table header, a page-aligned parameter block for
# POKE/SYS callers, and the code. fill = yes on the first two keeps the file
# contiguous so every promised offset holds when the whole binary is loaded
# in one go.
#
# SPDX-License-Identifier: MIT

MEMORY {
    HDR:  start = @BASE@,        size = $0100, type = rw, file = %O, fill = yes;
    PARM: start = @BASE@ + $100, size = $0200, type = rw, file = %O, fill = yes;
    MAIN: start = @BASE@ + $300, size = $1D00, type = rw, file = %O, fill = no;
}
SEGMENTS {
    BLOBHDR:  load = HDR,  type = ro;
    BLOBPARM: load = PARM, type = rw, define = yes;
    CODE:     load = MAIN, type = ro;
    RODATA:   load = MAIN, type = ro;
}
