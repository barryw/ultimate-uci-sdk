; Generated by tools/gen_protocol.py - DO NOT EDIT BY HAND.
;
; Ultimate Command Interface constants for ACME.
;
;     !source "uci_protocol.a"
;     lda #UCI_TARGET_DOS1
;
; The code itself is not linkable from ACME; use the standalone
; binary in bindings/blob, which needs no linking at all.
;
; SPDX-License-Identifier: MIT

; ---- Register map ----
; UCI I/O registers. The block is mapped at $DF1B-$DF1F and overlays the
; last five REU registers. Mapping is optional and is enabled in the
; Ultimate 'Command Interface' configuration menu.
UCI_REG_BUSID              = $DF1B  ; R   SoftwareIEC bus ID (0 = unset)
UCI_REG_CONTROL            = $DF1C  ; W   Control register
UCI_REG_STATUS             = $DF1C  ; R   Status register
UCI_REG_CMDDATA            = $DF1D  ; W   Command data (write command bytes here)
UCI_REG_IDENT              = $DF1D  ; R   Identification register
UCI_REG_RESPDATA           = $DF1E  ; R   Response data queue
UCI_REG_STATDATA           = $DF1F  ; R   Status data queue

; ---- Identification register values ----
; Read from UCI_REG_IDENT.
UCI_IDENT_IDLE             = $C9  ; No interrupt pending
UCI_IDENT_IRQ              = $49  ; Interrupt active (bit 7 cleared). FW 3.15+
UCI_IDENT_MASK             = $7F  ; Mask off the IRQ bit before comparing
UCI_IDENT_VALUE            = $49  ; Expected value after masking with UCI_IDENT_MASK

; ---- Control register bits ----
; Write-only. Always write a literal mask; never read-modify-write,
; because reading $DF1C returns the status register, not the control
; register.
UCI_CTRL_PUSH_CMD          = $01  ; Submit the buffered command
UCI_CTRL_DATA_ACC          = $02  ; Acknowledge / release the current data block
UCI_CTRL_ABORT             = $04  ; Request abort of the running command
UCI_CTRL_CLR_ERR           = $08  ; Clear the state-error flag
UCI_CTRL_IRQ               = $20  ; Raise IRQ on completion (FW 3.15+, latched on push)
UCI_CTRL_TRIGGER           = $40  ; Freeze the machine on the next $FF00 write (latched on push). NOT a transfer accelerator
UCI_CTRL_DMA               = $80  ; Freeze the machine immediately (latched on push). NOT a transfer accelerator - see docs/uci.md

; ---- Status register bits ----
; Read from $DF1C.
UCI_STAT_CMD_BUSY          = $01  ; A command is pending in command memory
UCI_STAT_DATA_ACC          = $02  ; Data acknowledge seen by the Ultimate
UCI_STAT_ABORT_P           = $04  ; Abort request still pending
UCI_STAT_ERROR             = $08  ; State error: command pushed while not idle
UCI_STAT_STATE             = $30  ; Protocol state mask
UCI_STAT_STAT_AV           = $40  ; Status byte available at $DF1F
UCI_STAT_DATA_AV           = $80  ; Response byte available at $DF1E

; ---- Protocol states ----
; Value of (status & UCI_STAT_STATE).
UCI_STATE_IDLE             = $00  ; Ready to accept a command
UCI_STATE_BUSY             = $10  ; Command submitted, Ultimate is working
UCI_STATE_DATA_LAST        = $20  ; Data available, this is the final block
UCI_STATE_DATA_MORE        = $30  ; Data available, more blocks follow

; ---- Queue sizes ----
; Hard limits enforced by the hardware. The three queue pointers all
; saturate on the LAST byte of their buffer rather than one past it, which
; costs a byte on the way in and can hang a naive reader on the way out -
; see docs/uci.md, 'Queue pointer saturation'.
UCI_MAX_COMMAND            = $0380  ; Command queue size in bytes ($380)
UCI_MAX_RESPONSE           = $0380  ; Response data queue size in bytes ($380)
UCI_MAX_STATUS             = $0100  ; Status queue size in bytes ($100)
UCI_MAX_COMMAND_USABLE     = $037F  ; Largest command the hardware can actually receive

; ---- Timeouts ----
; Budget for a status poll loop, in units of 256 polls. The core installs
; the default at bring-up, so the bounded-time guarantee holds without the
; caller doing anything; raise it around a command whose duration cannot
; be bounded and restore it after.
UCI_TIMEOUT_DEFAULT        = $C8  ; Comfortable for local commands at any CPU speed
UCI_TIMEOUT_FOREVER        = $00  ; Poll until the Ultimate answers, however long that takes

; ---- Targets ----
; First byte of every command. Only bits 0-3 select the target; bit 7 is
; the NO_REPLY flag (INFERRED from firmware).
UCI_TARGET_MASK            = $0F  ; Target field of the first command byte
UCI_TARGET_NO_REPLY        = $80  ; Fire-and-forget: skip the data/status phase
UCI_TARGET_DOS1            = $01  ; Ultimate DOS instance 1
UCI_TARGET_DOS2            = $02  ; Ultimate DOS instance 2
UCI_TARGET_NETWORK         = $03  ; Network (TCP/UDP sockets)
UCI_TARGET_CONTROL         = $04  ; Machine / cartridge control
UCI_TARGET_SOFTIEC         = $05  ; SoftwareIEC bypass
UCI_TARGET_HTTP            = $06  ; HTTP client (FW 3.15+)
UCI_TARGET_MAX             = $0F  ; Highest addressable target

; ---- Commands common to every target ----
UCI_CMD_IDENTIFY           = $01  ; Return an identification string. Cannot fail.

; ---- Ultimate DOS commands (targets $01/$02) ----
DOS_CMD_IDENTIFY           = $01
DOS_CMD_OPEN_FILE          = $02  ; <attrib> <filename> - attrib is a DOS_FA_* mask
DOS_CMD_CLOSE_FILE         = $03
DOS_CMD_READ_DATA          = $04  ; <len:16> - arrives as 512-byte blocks; uci_exec walks the chain
DOS_CMD_WRITE_DATA         = $05  ; $00 $00 <data...> - the two fixed bytes are skipped, not stored
DOS_CMD_FILE_SEEK          = $06  ; <pos:32>
DOS_CMD_FILE_INFO          = $07
DOS_CMD_FILE_STAT          = $08  ; <filename>
DOS_CMD_DELETE_FILE        = $09  ; <filename>
DOS_CMD_RENAME_FILE        = $0A  ; <old> $00 <new>
DOS_CMD_COPY_FILE          = $0B  ; <src> $00 <dst>
DOS_CMD_CHANGE_DIR         = $11  ; <dirname>
DOS_CMD_GET_PATH           = $12
DOS_CMD_OPEN_DIR           = $13
DOS_CMD_READ_DIR           = $14
DOS_CMD_COPY_UI_PATH       = $15  ; Deprecated since FW 3.0
DOS_CMD_CREATE_DIR         = $16  ; <dirname>
DOS_CMD_COPY_HOME_PATH     = $17
DOS_CMD_LOAD_REU           = $21  ; <addr:32> <len:32> - the safe REU pair; never wrap the control pair, see #740
DOS_CMD_SAVE_REU           = $22  ; <addr:32> <len:32> - the safe REU pair; never wrap the control pair, see #740
DOS_CMD_MOUNT_DISK         = $23  ; <id> <filename>
DOS_CMD_UMOUNT_DISK        = $24  ; <id>
DOS_CMD_SWAP_DISK          = $25  ; <id>
DOS_CMD_GET_TIME           = $26  ; <fmt> - fmt may be omitted; the target defaults it to $00
DOS_CMD_SET_TIME           = $27  ; <year_1900> <month> <day> <hour> <minute> <second> - year is the year minus 1900
DOS_CMD_ECHO               = $F0  ; <data...> - Echo the command back as data

; ---- DOS file open attributes ----
; Bit flags for DOS_CMD_OPEN_FILE.
DOS_FA_READ                = $01  ; Open for reading
DOS_FA_WRITE               = $02  ; Open for writing, do not truncate
DOS_FA_CREATE_NEW          = $04  ; Create/truncate to zero bytes
DOS_FA_CREATE_ALWAYS       = $08  ; May overwrite an existing file

; ---- DOS directory entry attributes ----
; First byte of each DOS_CMD_READ_DIR entry (FAT semantics).
DOS_ATTR_READONLY          = $01
DOS_ATTR_HIDDEN            = $02
DOS_ATTR_SYSTEM            = $04
DOS_ATTR_VOLUME            = $08
DOS_ATTR_DIR               = $10
DOS_ATTR_ARCHIVE           = $20

; ---- Network commands (target $03) ----
NET_CMD_IDENTIFY           = $01
NET_CMD_GET_INTERFACE_COUNT = $02
NET_CMD_GET_NETADDR        = $04  ; <iface> - replies with UCI_NET_MACADDR_BYTES
NET_CMD_GET_IPADDR         = $05  ; <iface> - replies with UCI_NET_IPCONFIG_BYTES, ip/mask/gw
NET_CMD_SET_IPADDR         = $06  ; <iface> <ipconfig...> - ipconfig must be exactly UCI_NET_IPCONFIG_BYTES
NET_CMD_OPEN_TCP           = $07  ; <port:16> <host>
NET_CMD_OPEN_UDP           = $08  ; <port:16> <host>
NET_CMD_CLOSE_SOCKET       = $09  ; <handle>
NET_CMD_READ_SOCKET        = $10  ; <handle> <len:16>
NET_CMD_WRITE_SOCKET       = $11  ; <handle> <data...>
NET_CMD_LISTEN_START       = $12  ; <port:16> - INFERRED: not in the published spec
NET_CMD_LISTEN_STOP        = $13  ; INFERRED: not in the published spec
NET_CMD_LISTEN_STATE       = $14  ; INFERRED: not in the published spec
NET_CMD_LISTEN_SOCKET      = $15  ; INFERRED: not in the published spec

; ---- Network address sizes ----
; Fixed-width blobs the network target exchanges.
UCI_NET_MACADDR_BYTES      = $06  ; bytes in a MAC address
UCI_NET_IPCONFIG_BYTES     = $0C  ; bytes in an ip/mask/gateway triple

; ---- Control commands (target $04) ----
CTRL_CMD_IDENTIFY          = $01
CTRL_CMD_READ_RTC          = $02  ; INFERRED: firmware only, not in the published spec
CTRL_CMD_FINISH_CAPTURE    = $03
CTRL_CMD_FREEZE            = $05
CTRL_CMD_REBOOT            = $06  ; Never replies: the C64 and the UCI are reset
CTRL_CMD_LOAD_REU          = $08  ; <filename> - never returns on FW 3.14d and wedges the interface, see #740
CTRL_CMD_SAVE_REU          = $09  ; <filename>
CTRL_CMD_U64_SAVEMEM       = $0F  ; <filename> - U64 family only
CTRL_CMD_DECODE_TRACK      = $11  ; GCR -> binary in REU
CTRL_CMD_ENCODE_TRACK      = $12  ; INFERRED: firmware only, not in the published spec
CTRL_CMD_EASYFLASH         = $20  ; $00 <bank> <baseaddr> - sector erase; baseaddr bit $20 selects the high ROM
CTRL_CMD_GET_HWINFO        = $28  ; <sub> - sub may be omitted; the target defaults it to CTRL_HWINFO_MODEL
CTRL_CMD_GET_DRVINFO       = $29  ; <effective_addr>
CTRL_CMD_ENABLE_DRIVE_A    = $30
CTRL_CMD_DISABLE_DRIVE_A   = $31
CTRL_CMD_ENABLE_DRIVE_B    = $32
CTRL_CMD_DISABLE_DRIVE_B   = $33
CTRL_CMD_GET_DRIVE_A_POWER = $34
CTRL_CMD_GET_DRIVE_B_POWER = $35
CTRL_CMD_GET_RAMDISKINFO   = $40  ; GEOS MegaPatch 3 RAM disk layout
CTRL_CMD_LOAD_CONFIG       = $50  ; INFERRED: firmware only, not in the published spec
CTRL_CMD_GET_PALETTE       = $51  ; -> 48 RGB bytes (FW > 3.15)
CTRL_CMD_SET_PALETTE       = $52  ; <palette...> - palette is exactly UCI_PALETTE_BYTES (FW > 3.15)
CTRL_CMD_SET_PALETTE_COLOR = $53  ; <index> <r> <g> <b> - (FW > 3.15)
CTRL_CMD_RESET_PALETTE     = $54  ; restore the built-in palette (FW > 3.15)

; ---- Control: VIC-II palette ----
; Runtime palette control. Affects the live palette only; it does not
; touch flash configuration or VPL files.
UCI_PALETTE_COLORS         = $10  ; colors in a VIC-II palette
UCI_PALETTE_BYTES          = $30  ; bytes in a full palette frame (16 * RGB)

; ---- Control: hardware info sub-commands ----
CTRL_HWINFO_MODEL          = $00  ; ASCII model name, e.g. 'ULTIMATE 64'
CTRL_HWINFO_SID            = $01  ; SID configuration frames

; ---- Control: drive type codes ----
; From CTRL_CMD_GET_DRVINFO.
CTRL_DRVTYPE_1541          = $00
CTRL_DRVTYPE_1571          = $01
CTRL_DRVTYPE_1581          = $02
CTRL_DRVTYPE_UNDECIDED     = $03
CTRL_DRVTYPE_SOFTIEC       = $0F
CTRL_DRVTYPE_PRINTER       = $50

; ---- SoftwareIEC commands (target $05) ----
SOFTIEC_CMD_IDENTIFY       = $01  ; answers in ASCII; every other command on this target answers in binary
SOFTIEC_CMD_LOAD_SU        = $10  ; <sec> <verify> <addr:16> <unused:16> <name> - sec 1 uses the file's own load address, 0 uses addr; unused is never read but must be sent
SOFTIEC_CMD_LOAD_EX        = $11  ; <sec> <verify> - returns the end address in status bytes 1-2
SOFTIEC_CMD_SAVE           = $12  ; <verify> <sec> <start:16> <end:16> <name>
SOFTIEC_CMD_OPEN           = $13  ; <sec> $00 <name>
SOFTIEC_CMD_CLOSE          = $14  ; <sec>
SOFTIEC_CMD_CHKIN          = $15  ; <sec>
SOFTIEC_CMD_CHKOUT         = $16  ; <sec> $00 <data...> - sec & $F0 of $F0 opens and $E0 closes; anything else pushes data
SOFTIEC_CMD_ADD_PARTITION  = $20  ; <index> <ident_colon_path> - the string is 'IDENT:/path'
SOFTIEC_CMD_DEL_PARTITION  = $21  ; <index>
SOFTIEC_CMD_GET_FATNAME    = $22  ; <channel> <iec_name> - resolves an IEC name to a host path
SOFTIEC_CMD_GET_IECNAME    = $23  ; <fat_name>

; ---- SoftwareIEC status bytes ----
; This target returns a single binary status byte, not an ASCII status
; string.
SOFTIEC_ST_OK              = $00
SOFTIEC_ST_FILE_NOT_FOUND  = $01
SOFTIEC_ST_SAVE_ERROR      = $02
SOFTIEC_ST_NO_INPUT_CHANNEL = $03
SOFTIEC_ST_UNKNOWN_COMMAND = $04
SOFTIEC_ST_MODULE_NOT_LOADED = $05
SOFTIEC_ST_INVALID_PARAMS  = $06
SOFTIEC_ST_INVALID_NAME    = $07
SOFTIEC_ST_INVALID_PARTITION = $08
SOFTIEC_ST_INVALID_DIRECTORY = $09
SOFTIEC_ST_VERIFY_ERROR    = $80  ; LOAD_EX verify mismatch

; ---- HTTP commands (target $06, FW 3.15+) ----
HTTP_CMD_IDENTIFY          = $01
HTTP_CMD_FREE_ALL          = $10
HTTP_CMD_HEADER_CREATE     = $11  ; <verb> <url> - verb is an HTTP_VERB_* code
HTTP_CMD_HEADER_FREE       = $12  ; <handle>
HTTP_CMD_HEADER_ADD        = $13  ; <handle> <key_colon_value> - the string is 'key: value'
HTTP_CMD_HEADER_QUERY      = $14  ; <handle> <key>
HTTP_CMD_HEADER_LIST       = $15  ; <handle> <index>
HTTP_CMD_BODY_CREATE       = $21  ; <format> - format is an HTTP_BODY_* code
HTTP_CMD_BODY_FREE         = $22  ; <handle>
HTTP_CMD_BODY_ADD_INT      = $23  ; <handle> <key:len> <key> <value:32> - 1 to 4 value bytes are accepted, sign-extended from the last; send four
HTTP_CMD_BODY_ADD_BOOL     = $24  ; <handle> <key:len> <key> <value> - any non-zero value is true
HTTP_CMD_BODY_ADD_STRING   = $25  ; <handle> <key:len> <key> <value:len> <value>
HTTP_CMD_BODY_ADD_OBJECT   = $26  ; <handle> <key:len> <key>
HTTP_CMD_BODY_ADD_ARRAY    = $27  ; <handle> <key:len> <key>
HTTP_CMD_BODY_UP           = $28  ; <handle>
HTTP_CMD_BODY_REMOVE       = $29  ; <handle> <path>
HTTP_CMD_BODY_QUERY        = $2A  ; <handle> <path>
HTTP_CMD_BODY_MOVE         = $2B  ; <handle> <path>
HTTP_CMD_BODY_ADD_BINARY   = $2C  ; <handle> <data...>
HTTP_CMD_BODY_ADD          = $2D  ; <handle> <items...>
HTTP_CMD_BODY_CLEAR        = $2E  ; <handle>
HTTP_CMD_DO_EXCHANGE_OBJ   = $31  ; <header> <body> - pass HTTP_BODY_NONE as body to send none
HTTP_CMD_DO_EXCHANGE_RAW   = $32  ; <header> <body> - pass HTTP_BODY_NONE as body to send none

; ---- HTTP verbs ----
HTTP_VERB_GET              = $01
HTTP_VERB_PUT              = $02
HTTP_VERB_POST             = $03
HTTP_VERB_PATCH            = $04
HTTP_VERB_DELETE           = $05
HTTP_VERB_HEAD             = $06
HTTP_VERB_OPTIONS          = $07
HTTP_VERB_CONNECT          = $08
HTTP_VERB_TRACE            = $09

; ---- HTTP body formats ----
HTTP_BODY_BINARY           = $01
HTTP_BODY_JSON_OBJECT      = $02
HTTP_BODY_JSON_ARRAY       = $03
HTTP_BODY_URL_ENCODED      = $04
HTTP_BODY_NONE             = $FF  ; Pass as <body> to send no body

; ---- HTTP / JSON value type tags ----
; Used by BODY_ADD and BODY_QUERY.
HTTP_TYPE_INT              = $01  ; 4 bytes, LSB first
HTTP_TYPE_BOOL             = $02  ; 1 byte
HTTP_TYPE_STRING           = $03  ; <len> <bytes>
HTTP_TYPE_OBJECT           = $04  ; <count> [<key> <value>]*
HTTP_TYPE_ARRAY            = $05  ; <count> [<value>]*

; ---- Ultimate 64 turbo control (NOT UCI) ----
; The one part of the machine the SDK reaches without the command
; interface, because there is no UCI command for CPU speed. Plain memory-
; mapped registers, documented at 1541u-documentation.readthedocs.io. They
; answer $FF unless the Ultimate's 'Turbo Control' setting is 'U64 Turbo
; Registers' or 'Turbo Enable Bit', which is what makes availability
; testable rather than assumed.
U64_REG_TURBO              = $D031  ; R/W  bits 0-3 speed index, bit 7 badlines off
U64_REG_TURBO_ENABLE       = $D030  ; R/W  bit 0, in 'Turbo Enable Bit' mode only
U64_TURBO_SPEED_MASK       = $0F  ; speed index field of U64_REG_TURBO
U64_TURBO_NO_BADLINES      = $80  ; set to stop the VIC stealing cycles
U64_TURBO_UNAVAILABLE      = $FF  ; what both registers read when turbo is off in config

; ---- Ultimate 64 speed indices ----
; Index into the machine's speed table. **Only these four mean the same
; thing on both machines.** The U64 runs 1,2,3,4,5,6,8..48 MHz and the
; U64-II runs 1,2,3,4,6,8..64, so index 4 is 5 MHz on one and 6 MHz on the
; other. Above 4 MHz, ask for an index and you get whatever that machine's
; table says.
U64_SPEED_1MHZ             = $00  ; stock C64 speed, and what turbo_off restores
U64_SPEED_2MHZ             = $01
U64_SPEED_3MHZ             = $02
U64_SPEED_4MHZ             = $03  ; the fastest index that means the same on both
U64_SPEED_MAX              = $0F  ; whatever the machine's top speed is: 48 or 64 MHz

; ---- SDK status / error codes ----
; Stable across firmware versions. The raw device status is preserved
; separately, see uci_last_device_code().
ULTIMATE_OK                = $00  ; Success (device may still have set a warning code)
ULTIMATE_ERR_NO_DEVICE     = $01  ; No Ultimate Command Interface found
ULTIMATE_ERR_TIMEOUT       = $02  ; The Ultimate did not answer in time
ULTIMATE_ERR_PROTOCOL      = $03  ; Transport-level protocol violation
ULTIMATE_ERR_NOT_SUPPORTED = $04  ; Target or command not implemented by this firmware
ULTIMATE_ERR_INVALID_ARGUMENT = $05  ; Bad argument supplied by the caller
ULTIMATE_ERR_IO            = $06  ; File system / network I/O failure
ULTIMATE_ERR_DEVICE        = $07  ; Target reported a failure status
ULTIMATE_ERR_TRUNCATED     = $08  ; Reply did not fit in the caller's buffer
ULTIMATE_ERR_ABORTED       = $09  ; Command was aborted
ULTIMATE_END               = $0A  ; No more entries: the end of a directory, not a failure
ULTIMATE_ERR_COUNT         = $0B  ; Number of codes above, for a table that maps them

; ---- Request block layout ----
; Byte offsets into a uci_request. The assembly core is the authority on
; this layout; bindings/cc65/abi_assert.c fails the build if the C struct
; ever stops matching.
UCI_REQ_TARGET             = $00  ; byte: target id, optionally | UCI_TARGET_NO_REPLY
UCI_REQ_COMMAND            = $01  ; byte: command code
UCI_REQ_ARGS               = $02  ; word: pointer to argument bytes, 0 for none
UCI_REQ_ARGLEN             = $04  ; word: number of argument bytes
UCI_REQ_PAYLOAD            = $06  ; word: pointer to payload bytes, 0 for none
UCI_REQ_PAYLOADLEN         = $08  ; word: number of payload bytes
UCI_REQ_DATA               = $0A  ; word: buffer for the reply, 0 to discard it
UCI_REQ_DATAMAX            = $0C  ; word: size of that buffer
UCI_REQ_DATALEN            = $0E  ; word: out, reply bytes stored
UCI_REQ_STATUS             = $10  ; word: buffer for the status string, 0 to discard
UCI_REQ_STATUSMAX          = $12  ; word: size of that buffer
UCI_REQ_STATUSLEN          = $14  ; word: out, status bytes stored
UCI_REQ_SIZE               = $16  ; total size of the block

; ---- SDK memory footprint ----
; How much RAM the core needs, and where. All of it is placeable: see
; UCI_ZP and UCI_VARS in docs/asm-abi.md.
UCI_ZP_SIZE                = $04  ; zero page bytes the core needs
UCI_VARS_SIZE              = $6F  ; non-zero-page bytes the whole SDK needs

; ---- ASCII literals ----
; Bytes that come off the wire are always written numerically. An
; assembler charmap, or a compiler's idea of the target character set,
; must never reach them: cc65 turns "NO TARGET" into PETSCII, which
; silently stops matching what the Ultimate sends.
UCI_ASCII_ZERO             = $30  ; '0'
UCI_ASCII_NINE             = $39  ; '9'
UCI_ASCII_COMMA            = $2C  ; ','
UCI_ASCII_SPACE            = $20  ; ' '

; ---- Status string families ----
; Targets do not agree on how status is encoded; the SDK picks a decoder
; per target.
UCI_STATUS_FMT_DECIMAL2    = $00  ; 'NN,TEXT' - DOS, Network, Control
UCI_STATUS_FMT_DECIMAL3    = $01  ; 'NNN TEXT' - HTTP
UCI_STATUS_FMT_BINARY      = $02  ; single binary byte - SoftwareIEC
UCI_STATUS_FMT_NONE        = $03  ; target sends no status
