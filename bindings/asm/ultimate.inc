; ultimate.inc - Ultimate SDK assembly interface (ca65).
;
; Assembly is a first-class caller of this SDK, not an afterthought. The entry
; points below take their arguments the way 6502 code wants them: a byte in a
; register, or a fixed request block in RAM. Nothing here needs the C stack.
;
;     .include "ultimate.inc"
;
;             jsr ultimate_init
;             cmp #ULTIMATE_OK
;             bne no_ultimate
;
;             lda #UCI_TARGET_DOS1
;             sta uci_req + UCI_REQ_TARGET
;             lda #UCI_CMD_IDENTIFY
;             sta uci_req + UCI_REQ_COMMAND
;             ...
;             jsr uci_exec_block      ; A = ULTIMATE_* result code
;
; Build with cl65, which assembles this and links the SDK library:
;
;     cl65 -t c64 -I include myprog.s ultimate.lib -o myprog.prg
;
; See docs/asm-abi.md for the register contract, and bindings/asm/README.md for
; what to do when your assembler is not ca65.
;
; SPDX-License-Identifier: MIT

.ifndef ULTIMATE_INC
ULTIMATE_INC = 1

.include "uci_protocol.inc"

; ---------------------------------------------------------------------------
; The uci_request layout (UCI_REQ_*) comes from uci_protocol.inc, generated by
; tools/gen_protocol.py. The assembly core is the authority on it;
; bindings/cc65/abi_assert.c fails the build if the C struct stops matching.
; See docs/asm-abi.md for the field table.
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; Entry points
;
; All of them return the result code in A and leave X and Y undefined.
; None of them require interrupts, and none of them use zero page beyond the
; locations the C runtime already owns - see docs/asm-abi.md.
; ---------------------------------------------------------------------------

.global uci_req              ; UCI_REQ_SIZE bytes of request block: in BSS by
                              ; default, an equate off UCI_VARS if it is defined

.global ultimate_init        ; ->  A = ULTIMATE_OK or an error code
.global ultimate_available   ; ->  A = 1 when the SDK is up, 0 otherwise
.global uci_exec_block       ; runs the command described by uci_req
.global uci_abort            ; force the interface back to idle
.global uci_set_timeout_a    ; A = timeout units (0 = wait forever)
.global uci_get_timeout_a    ; ->  A = current timeout units
.global uci_present          ; ->  A = 1 when the signature is on the bus
.global uci_ident            ; ->  A = raw identification register
.global uci_last_code        ; ->  A = low, X = high of the raw device code

; These three take more than fits in registers, so the extra parameters go in
; the shared variable block below - set them before calling. See docs/asm-abi.md.
.global ultimate_identify    ; A = target, ult_buf/ult_buflen/ult_outlen -> A = result
.global ultimate_get_model   ; deprecated HWINFO; retained for compatibility
.global ultimate_legacy_get_sid_info ; deprecated HWINFO; A/X = SID info block
.global ultimate_detect      ; A/X = pointer to a 4-byte capability block -> A = result
.global ultimate_strerror    ; A = result code -> A/X = pointer to PETSCII text

.global ult_buf, ult_buflen  ; caller's output buffer and its size, for
.global ult_outlen           ; ultimate_identify / ultimate_get_model; ult_outlen
                              ; is where the length written is reported, 0 for nowhere

; The legacy function's count-prefixed result. Each record is the firmware's
; two little-endian addresses followed by its raw type byte. HWINFO is marked
; deprecated and may disappear; handle ULTIMATE_ERR_NOT_SUPPORTED.
ULTIMATE_SID_MAX                = 4
ULTIMATE_SID_RECORD_SIZE        = 5
ULTIMATE_SID_INFO_SIZE          = 1 + ULTIMATE_SID_MAX * ULTIMATE_SID_RECORD_SIZE
ULTIMATE_SID_INFO_COUNT         = 0
ULTIMATE_SID_INFO_RECORDS       = 1
ULTIMATE_SID_PRIMARY_ADDRESS    = 0
ULTIMATE_SID_SECONDARY_ADDRESS  = 2
ULTIMATE_SID_TYPE               = 4

; The core takes a request block by pointer, so a program with several blocks
; can call it directly instead of going through uci_req:
.global uci_exec             ; A/X = pointer to a request block -> A = result

; Fill uci_req with zeroes. Call it before setting up a command unless you set
; every field yourself; a stale pointer from a previous command is a bug that
; is unpleasant to find.
.global uci_req_clear

; ---------------------------------------------------------------------------
; The services. Each one takes its wider arguments in the shared variable block
; below rather than in registers, because most of them have more arguments than
; a 6502 has registers. docs/asm-abi.md has the table.
; ---------------------------------------------------------------------------

.global ultimate_palette_get, ultimate_palette_set
.global ultimate_palette_set_color, ultimate_palette_reset
.global ult_color            ; index, r, g, b for palette_set_color

.global ultimate_turbo_available, ultimate_turbo_get
.global ultimate_turbo_set, ultimate_turbo_badlines

.global ultimate_chdir, ultimate_getpath
.global ultimate_opendir, ultimate_readdir
.global ultimate_open, ultimate_close, ultimate_read
.global ultimate_write, ultimate_seek, ultimate_delete
.global ult_attrib           ; open's DOS_FA_* mask in, readdir's attributes out
.global ult_num              ; seek's 32-bit position

; --- dosinfo.s -------------------------------------------------------------
; stat's reply has the layout below and is received straight into the caller's
; block; the name is NUL-terminated afterwards. Rename and copy take the second
; name in ult_arg2 - the request block has two spans and those commands have
; three runs of bytes, so the first name's own terminator is what separates
; them on the wire.
.global ultimate_stat        ; ult_buf = name, ult_arg2 = the block -> A
.global ultimate_fstat       ; ult_arg2 = the block, for the open file -> A
.global ultimate_rename      ; ult_buf = old, ult_arg2 = new -> A
.global ultimate_copy        ; ult_buf = source, ult_arg2 = destination -> A
.global ultimate_mkdir       ; ult_buf = name -> A
.global ultimate_home        ; -> A
.global ult_arg2             ; the second caller string

ULTIMATE_FILEINFO_SIZE = DOS_INFO_NAME + DOS_INFO_NAME_MAX + 1

; --- disk.s ----------------------------------------------------------------
; The drive is named by the IEC device number it answers as, not by a slot.
; ULTIMATE_DRIVE_LAST asks for whichever was mounted into last.
ULTIMATE_DRIVE_LAST = 0
.global ultimate_mount       ; A = device, ult_buf = image name -> A
.global ultimate_unmount     ; A = device -> A
.global ultimate_swap        ; A = device -> A

; --- clock.s ---------------------------------------------------------------
; The clock reads back as text and is set with numbers, and the year byte is
; the year less 1900.
ULTIMATE_TIME_PLAIN   = 0
ULTIMATE_TIME_WEEKDAY = 1
ULTIMATE_TIME_BUFFER  = 24
.global ultimate_get_time    ; A = format, ult_buf/ult_buflen/ult_outlen -> A
.global ultimate_set_time    ; ult_stage = year-1900, month, day, hour, min, sec
.global ult_stage            ; the staging buffer, ULT_STAGE_SIZE bytes
.global ult_stagelen         ; how much of it the command being built uses
.global ult_val              ; a scalar argument, four bytes

; --- control.s -------------------------------------------------------------
; ultimate_reboot does not return: the C64 is reset part way through it.
; ultimate_freeze returns when whoever is at the keyboard leaves the menu.
;
; ultimate_drive_enable and ultimate_drive_power name a drive with
; ULTIMATE_DRIVE_A or ULTIMATE_DRIVE_B, and there are no others: the firmware
; has one command per drive and it has commands for those two only.
; ultimate_drive_info is not bounded by that. Its reply also carries the
; occupied IEC bus slots, so its block is CTRL_DRVINFO_BYTES - the count and
; CTRL_DRVINFO_MAX records - and its count is what arrived, not what the reply
; claimed.
ULTIMATE_DRIVE_A = 0
ULTIMATE_DRIVE_B = 1
.global ultimate_reboot      ; -> nothing after this line runs
.global ultimate_freeze      ; -> A, when the machine is let go again
.global ultimate_drive_enable ; A = drive, X = 0 to switch it off -> A
.global ultimate_drive_power ; A = drive -> A, ult_stage = 1 when it is running
.global ultimate_drive_info  ; A/X = a CTRL_DRVINFO_BYTES block -> A
.global ultimate_ramdisk_info ; A/X = a CTRL_RAMDISK_BYTES block -> A

.global ultimate_load, ultimate_bload, ultimate_save, ultimate_last_end
.global ult_addr             ; where a load puts it, or a save takes it from
.global ult_max              ; bload's limit, save's length
.global ult_end              ; the address after the last byte loaded

.global ultimate_reu_available
.global ultimate_reu_size    ; -> A/X = size in 64K banks, 0 = none
.global ultimate_reu_stash, ultimate_reu_fetch
.global ultimate_reu_load, ultimate_reu_save
.global ult_reu, ult_reulen  ; REU address, then length: eight bytes, in that
                              ; order, because the DOS pair sends them as one span

.global ultimate_audio_init, ultimate_audio_available, ultimate_audio_version
.global ultimate_audio_configure ; A/X = ultimate_audio_voice -> A = result
.global ultimate_audio_start     ; A = channel, X = UA_CTRL_* flags -> A = result
.global ultimate_audio_stop      ; A = channel -> A = result
.global ultimate_audio_irq_status ; -> A = end-of-sample channel mask
.global ultimate_audio_irq_clear ; A = channel -> A = result

; --- net.s -----------------------------------------------------------------
; Measured behaviour, not documented behaviour - see src/uci/net.s for all of
; it. The three that decide how these are called: a read never waits, so poll;
; ULTIMATE_END means the peer hung up and is said once; and a connect can take
; 30 seconds, which no timeout budget can express, so the two open calls wait
; without a limit and put the caller's budget back.
.global ultimate_net_ifcount ; -> A = result, ult_iface = interfaces
.global ultimate_net_macaddr ; ult_iface, ult_buf = 6 bytes -> A = result
.global ultimate_net_ipconfig ; ult_iface, ult_buf = 12 bytes -> A = result
.global ultimate_net_connect ; ult_port, ult_buf = host -> A, ult_sock = handle
.global ultimate_net_udp     ; the same, for UDP
.global ultimate_net_setip   ; ult_iface, ult_buf = 12 bytes -> A = result
.global ultimate_net_close   ; ult_sock -> A = result
.global ultimate_net_read    ; ult_sock, ult_buf, ult_socklen = buffer size
                             ; -> A = result, ult_socklen = bytes stored
.global ultimate_net_write   ; ult_sock, ult_buf, ult_buflen
                             ; -> A = result, ult_socklen = bytes accepted
.global ult_sock             ; socket handle, in and out
.global ult_socklen          ; buffer size in, bytes moved out; follows ult_sock
                             ; because the wire wants the two adjacent
.global ult_iface            ; interface index in, interface count out
.global ult_port             ; TCP or UDP port, little-endian

; --- http.s ----------------------------------------------------------------
; ULTIMATE_OK means the server answered below 400; the number is in
; uci_last_code and the response headers are in the caller's status buffer.
; An exchange is not bounded by the timeout budget - it contains a name lookup
; and a connect - so it waits and restores the caller's budget, like connect.
.global ultimate_http_get      ; ult_url, ult_buf/ult_buflen -> A, ult_httplen
.global ultimate_http_open     ; A = HTTP_VERB_*, ult_url -> A, ult_http
.global ultimate_http_header   ; ult_http, ult_url = "key: value" -> A
.global ultimate_http_exchange ; ult_http, ult_body, ult_buf/ult_buflen
                               ; -> A, ult_httplen
.global ultimate_http_close    ; ult_http -> A
.global ultimate_http_free_all ; every slot the firmware is holding -> A
.global ult_url                ; URL, or a header line
.global ult_http               ; verb in, header handle out; $FF after a failure
.global ult_body               ; body handle, or HTTP_BODY_NONE; follows ult_http
                               ; because an exchange sends the pair
.global ult_httplen            ; reply bytes stored

; --- httpbody.s ------------------------------------------------------------
; The body is built inside the Ultimate: create a slot, add to it a call at a
; time, and hand the handle to ultimate_http_exchange. Adding an object or an
; array enters it; ultimate_http_body_up steps back out. A key is copied through
; ult_stage, so it is limited to ULTIMATE_HTTP_KEY_MAX bytes; values are not.
ULTIMATE_HTTP_KEY_MAX = 34
.global ultimate_http_body        ; A = HTTP_BODY_* format -> A, ult_body
.global ultimate_http_body_free   ; ult_body -> A
.global ultimate_http_body_clear  ; ult_body -> A
.global ultimate_http_body_up     ; ult_body -> A
.global ultimate_http_body_int    ; ult_body, ult_url = key, ult_val = value
.global ultimate_http_body_bool   ; ult_body, ult_url = key, ult_val = 0 or not
.global ultimate_http_body_string ; ult_body, ult_url = key, ult_buf = value
.global ultimate_http_body_object ; ult_body, ult_url = key -> A
.global ultimate_http_body_array  ; ult_body, ult_url = key -> A
.global ultimate_http_body_binary ; ult_body, ult_buf, ult_buflen -> A

; Reading a directory is one live exchange, one entry per call, and these are
; the two halves of it for a caller driving the transport itself:
.global uci_exec_first, uci_exec_next, uci_more

.endif
