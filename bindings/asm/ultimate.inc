; ultimate.inc - Ultimate SDK assembly interface (ca65).
;
; Assembly is a first-class caller of this SDK, not an afterthought. The entry
; points below take their arguments the way 6502 code wants them: a byte in a
; register, or a fixed request block in RAM. Nothing here needs the C stack.
;
;     .include "ultimate.inc"
;
;             jsr ultimate_init
;             cmp #ULTIMATE_OK
;             bne no_ultimate
;
;             lda #UCI_TARGET_DOS1
;             sta uci_req + UCI_REQ_TARGET
;             lda #UCI_CMD_IDENTIFY
;             sta uci_req + UCI_REQ_COMMAND
;             ...
;             jsr uci_exec_block      ; A = ULTIMATE_* result code
;
; Build with cl65, which assembles this and links the SDK library:
;
;     cl65 -t c64 -I include myprog.s ultimate.lib -o myprog.prg
;
; See docs/asm-abi.md for the register contract, and bindings/asm/README.md for
; what to do when your assembler is not ca65.
;
; SPDX-License-Identifier: MIT

.ifndef ULTIMATE_INC
ULTIMATE_INC = 1

.include "uci_protocol.inc"

; ---------------------------------------------------------------------------
; The uci_request layout (UCI_REQ_*) comes from uci_protocol.inc, generated by
; tools/gen_protocol.py. The assembly core is the authority on it;
; bindings/cc65/abi_assert.c fails the build if the C struct stops matching.
; See docs/asm-abi.md for the field table.
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; Entry points
;
; All of them return the result code in A and leave X and Y undefined.
; None of them require interrupts, and none of them use zero page beyond the
; locations the C runtime already owns - see docs/asm-abi.md.
; ---------------------------------------------------------------------------

.global uci_req              ; UCI_REQ_SIZE bytes of request block: in BSS by
                              ; default, an equate off UCI_VARS if it is defined

.global ultimate_init        ; ->  A = ULTIMATE_OK or an error code
.global ultimate_available   ; ->  A = 1 when the SDK is up, 0 otherwise
.global uci_exec_block       ; runs the command described by uci_req
.global uci_abort            ; force the interface back to idle
.global uci_set_timeout_a    ; A = timeout units (0 = wait forever)
.global uci_get_timeout_a    ; ->  A = current timeout units
.global uci_present          ; ->  A = 1 when the signature is on the bus
.global uci_ident            ; ->  A = raw identification register
.global uci_last_code        ; ->  A = low, X = high of the raw device code

; These three take more than fits in registers, so the extra parameters go in
; the shared variable block below - set them before calling. See docs/asm-abi.md.
.global ultimate_identify    ; A = target, ult_buf/ult_buflen/ult_outlen -> A = result
.global ultimate_get_model   ; ult_buf/ult_buflen/ult_outlen set -> A = result
.global ultimate_detect      ; A/X = pointer to a 4-byte capability block -> A = result
.global ultimate_strerror    ; A = result code -> A/X = pointer to PETSCII text

.global ult_buf, ult_buflen  ; caller's output buffer and its size, for
.global ult_outlen           ; ultimate_identify / ultimate_get_model; ult_outlen
                              ; is where the length written is reported, 0 for nowhere

; The core takes a request block by pointer, so a program with several blocks
; can call it directly instead of going through uci_req:
.global uci_exec             ; A/X = pointer to a request block -> A = result

; Fill uci_req with zeroes. Call it before setting up a command unless you set
; every field yourself; a stale pointer from a previous command is a bug that
; is unpleasant to find.
.global uci_req_clear

.endif
