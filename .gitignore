# Build output
build/
*.o
*.prg
*.lbl
*.sym
*.map
*.lst

# cc65 intermediate assembly emitted next to the objects
bindings/cc65/build/
bindings/cc65/build-placed/
bindings/cc65/build-banked/

# Python bytecode
__pycache__/
*.pyc

# Subagent-driven development scratch
.superpowers/

# Oscar64 build artifacts
*.asm
*.int
*.dbj

# ...but the generated KickAssembler binding is a real, committed artifact.
!bindings/kickass/uci_protocol.asm

# Generated from sdk.suite for the relocated-memory build
tests/emulator/sdk-placed.suite

# Generated from the built blob's size, so neither can be stale
tests/emulator/blob-relocated.suite
tests/emulator/blobsize.inc

# C64 ROM images for the BASIC suite. Commodore's, not ours - never committed.
# Point C64_ROMS at a directory holding basic.bin and kernal.bin, or drop them
# here; tests/emulator/Makefile skips the suite when they are absent.
tests/emulator/roms/

# Wedge build output
src/basic/uci.prg
src/basic/uci.crt
src/basic/uci-cart.bin
src/basic/version.inc

# The guide builds a PDF and a pile of TeX litter.
guide/*.aux
guide/*.log
guide/*.out
guide/*.toc
guide/*.fls
guide/*.fdb_latexmk
guide/chapters/*.aux
guide/version.tex

# Release bundles are produced from a clean checkout by Woodpecker.
dist/
