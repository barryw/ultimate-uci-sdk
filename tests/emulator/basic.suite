; basic.suite - the BASIC wedge against the real BASIC ROM.
;
; The wedge's tokeniser only exists because of what the ROM's own CRUNCH does
; first, so testing it against anything other than the ROM would be testing a
; story about the ROM. Every test here puts text in the input buffer, runs the
; wedge's ICRNCH handler - which calls the ROM's tokeniser on the way - and
; looks at the bytes that came out.
;
;   make basic C64_ROMS=/path/to/roms
;
; **ROM-gated.** Commodore's ROM images cannot be committed, so the Makefile
; skips this suite with a message when it cannot find them. CI runs the rest.
;
; SPDX-License-Identifier: MIT

suites {
  suite("ultimate uci basic wedge") {
    system(c64)
    rom("basic", "/code/tests/emulator/roms/basic.bin")
    rom("kernal", "/code/tests/emulator/roms/kernal.bin")
    symbols("/code/tests/emulator/basic.sym")
    load("/code/src/basic/uci.prg", strip_header = true)

    ; The .prg loads at $0801; the wedge runs at $C000. Every test needs it
    ; moved there first, which is why copying is an entry point of its own.
    ; FRETOP and MEMSIZ are pinned to $A000 because $E3BF takes them from the
    ; KERNAL's memory-top call, which needs a machine this backend does not
    ; simulate. Without them string space is nowhere and UST$ or UDAT$ fails on
    ; allocation rather than on anything the wedge did.
    ;
    ; $FF87 is the KERNAL's RAM test, $E3BF is BASIC's zero page bring-up, and
    ; $A67A resets the stack. None is optional. $E3BF copies the CHRGET routine
    ; into zero page, without which nothing that reads BASIC text runs at all;
    ; $A67A is what the cold start does straight afterwards, and without it
    ; FRMEVL runs out of stack the moment an argument is an expression. On a
    ; real machine the user has been through all three before typing LOAD.
    setup {
      jsr($ff87, stop_on_rts = true, fail_on_brk = true)
      jsr($e3bf, stop_on_rts = true, fail_on_brk = true)
      jsr($a67a, stop_on_rts = true, fail_on_brk = true)
      $0033 = $00
      $0034 = $a0
      $0037 = $00
      $0038 = $a0
      jsr([wedge_copy], stop_on_rts = true, fail_on_brk = true)
      jsr([wedge_install], stop_on_rts = true, fail_on_brk = true)
    }

    test("wedge-install-takes-the-vectors", "installation is what makes the rest of this reachable") {
      [ICRNCH] = $00
      $0305 = $00
      [IQPLOP] = $00
      $0307 = $00
      [IGONE] = $00
      $0309 = $00
      [IEVAL] = $00
      $030b = $00
      jsr([wedge_install], stop_on_rts = true, fail_on_brk = true)
      assert([ICRNCH] == [wedge_crunch].l, "ICRNCH points at the tokenizer")
      assert($0305 == [wedge_crunch].h, "...both bytes of it")
      assert([IQPLOP] == [wedge_qplop].l, "IQPLOP points at the LIST hook")
      assert($0307 == [wedge_qplop].h, "...both bytes")
      assert([IGONE] == [wedge_gone].l, "IGONE points at statement dispatch")
      assert($0309 == [wedge_gone].h, "...both bytes")
      assert([IEVAL] == [wedge_eval].l, "IEVAL points at term evaluation")
      assert($030b == [wedge_eval].h, "...both bytes")
    }

    ; The control for every substitution test below. $A57C is the ROM's own
    ; tokeniser, called directly instead of through the wedge: it has to leave
    ; UCI as three letters. Without this, a wedge that did nothing at all would
    ; still pass a test asserting the ROM's output.
    test("rom-alone-leaves-uci-as-letters", "the ROM does not know these keywords") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $00
      $007a = $00
      $007b = $02
      jsr($a57c, stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $55, "'U'")
      assert($0201 == $43, "'C'")
      assert($0202 == $49, "'I'")
      assert($0203 == $00, "three letters, not one token")
    }

    ; LIST, the other half of owning a token. BASIC's LIST ends in the
    ; direct-mode loop rather than returning, and printing needs a screen editor
    ; this backend does not bring up, so these drive the lookup - the part with
    ; logic in it - and not the six instructions that hand bytes to OUTDO.
    test("list-finds-a-keyword-that-lists-as-it-matches", "the common case, one copy of the text") {
      a = $cc
      jsr([wedge_find_keyword], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_len] == $03, "UCI is three bytes")
      assert(a == $55, "starting with 'U'")
    }

    ; ULEN matches as 'U' $C3 and lists as four letters, so it is the one entry
    ; carrying a second copy of its text. Returning the match pattern instead
    ; would put a LEN token on the screen.
    test("list-finds-a-keyword-whose-forms-differ", "ULEN is not what the wedge matched") {
      a = $cf
      jsr([wedge_find_keyword], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_len] == $04, "four letters, not the two bytes it matched")
      assert(a == $55, "'U'")
    }

    ; The last entry, so the walk has to step over every other one - including
    ; the one in the middle that carries an extra field. Keep this pointing at
    ; whatever the final token is: the keyword table is append-only, so the
    ; last entry moves every time one is added, and a test aimed at the
    ; second-to-last stops proving the walk reaches the end.
    test("list-finds-the-last-keyword", "the table walk reaches the end") {
      a = $e1
      jsr([wedge_find_keyword], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_len] == $06, "UFETCH is six bytes")
      assert(a == $55, "'U'")
    }

    ; ULOAD is the worst case for the walk: its match pattern is two bytes and
    ; its display text is five, so an entry that carries a second copy sits
    ; between the start of the table and the end of it. LIST printing 'U' and a
    ; LOAD token would be the failure, and it would look like a working wedge
    ; until somebody listed a program.
    test("list-finds-a-file-keyword", "ULOAD lists as five letters, not as two bytes") {
      a = $dc
      jsr([wedge_find_keyword], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_len] == $05, "U, L, O, A, D")
      assert(a == $55, "'U'")
    }

    ; The generic statement. Everything else in phase 2 hangs off this token.
    test("tokenize-uci", "UCI becomes one token and the rest of the line survives") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $34
      $0207 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $cc, "UCI tokenized")
      assert($0201 == $20, "the space after it")
      assert($0202 == $31, "'1'")
      assert($0203 == $2c, "','")
      assert($0204 == $34, "'4'")
      assert($0205 == $00, "line terminated, three bytes shorter")
    }

    ; docs/generated/basic-keywords.md: ULEN reaches the wedge as 'U' $C3,
    ; because CRUNCH found LEN inside it. This is the test that fails if the
    ; match patterns ever go back to being the text a user types.
    test("tokenize-ulen-through-the-len-collision", "a keyword the ROM already half-tokenized") {
      $0200 = $55
      $0201 = $4c
      $0202 = $45
      $0203 = $4e
      $0204 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $cf, "ULEN tokenized despite the embedded LEN")
      assert($0201 == $00, "one byte, from four characters")
    }

    test("tokenize-a-constant", "target constants are tokens like any other keyword") {
      $0200 = $55
      $0201 = $44
      $0202 = $4f
      $0203 = $53
      $0204 = $31
      $0205 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $d5, "UDOS1 tokenized")
      assert($0201 == $00, "line terminated")
    }

    ; The paren is part of the keyword, exactly as it is for the ROM's TAB( and
    ; SPC(, so that UW stays usable as an ordinary variable name.
    test("tokenize-uw-takes-its-paren", "UW( is the keyword, not UW") {
      $0200 = $55
      $0201 = $57
      $0202 = $28
      $0203 = $33
      $0204 = $29
      $0205 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $d3, "UW( tokenized, paren included")
      assert($0201 == $33, "'3'")
      assert($0202 == $29, "')'")
      assert($0203 == $00, "line terminated")
    }

    test("basic-keywords-are-left-to-the-rom", "the wedge substitutes nothing it does not own") {
      $0200 = $50
      $0201 = $52
      $0202 = $49
      $0203 = $4e
      $0204 = $54
      $0205 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $99, "PRINT is still PRINT")
      assert($0201 == $00, "line terminated")
    }

    ; A keyword inside a string constant is text the user typed, and has to come
    ; back out of LIST exactly as it went in.
    test("keywords-inside-strings-are-not-substituted", "PRINT \"UCI\" keeps its three letters") {
      $0200 = $50
      $0201 = $52
      $0202 = $49
      $0203 = $4e
      $0204 = $54
      $0205 = $22
      $0206 = $55
      $0207 = $43
      $0208 = $49
      $0209 = $22
      $020a = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $99, "PRINT")
      assert($0201 == $22, "opening quote")
      assert($0202 == $55, "'U' survived")
      assert($0203 == $43, "'C' survived")
      assert($0204 == $49, "'I' survived")
      assert($0205 == $22, "closing quote")
      assert($0206 == $00, "line terminated")
    }

    ; The ROM stops tokenising after DATA, so the wedge has to stop too or a
    ; program's data would change meaning on the way in.
    test("data-contents-are-not-substituted", "DATA UCI is three letters of data") {
      $0200 = $44
      $0201 = $41
      $0202 = $54
      $0203 = $41
      $0204 = $20
      $0205 = $55
      $0206 = $43
      $0207 = $49
      $0208 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $83, "DATA")
      assert($0201 == $20, "space")
      assert($0202 == $55, "'U' is data, not a token")
      assert($0203 == $43, "'C'")
      assert($0204 == $49, "'I'")
      assert($0205 == $00, "line terminated")
    }

    ; ...and a colon ends the DATA statement, so substitution resumes. Getting
    ; this wrong would silently stop the wedge working for the rest of any line
    ; that contains a DATA statement.
    test("a-colon-ends-data-and-substitution-resumes", "DATA UCI:UCI is data then a token") {
      $0200 = $44
      $0201 = $41
      $0202 = $54
      $0203 = $41
      $0204 = $20
      $0205 = $55
      $0206 = $43
      $0207 = $49
      $0208 = $3a
      $0209 = $55
      $020a = $43
      $020b = $49
      $020c = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $83, "DATA")
      assert($0202 == $55, "the first UCI stayed as letters")
      assert($0205 == $3a, "the colon")
      assert($0206 == $cc, "the second UCI tokenized")
      assert($0207 == $00, "line terminated")
    }

    ; Two keywords in one line, to prove the compaction keeps up: the write
    ; index falls further behind the read index with every substitution.
    test("two-keywords-compact-correctly", "substitution shrinks the line in place") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $55
      $0205 = $44
      $0206 = $4f
      $0207 = $53
      $0208 = $31
      $0209 = $2c
      $020a = $34
      $020b = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $cc, "UCI")
      assert($0201 == $20, "space")
      assert($0202 == $d5, "UDOS1")
      assert($0203 == $2c, "','")
      assert($0204 == $34, "'4'")
      assert($0205 == $00, "line terminated, six bytes shorter")
    }

    ; An empty line has to survive, because RETURN on a blank line is the most
    ; common thing anyone types.
    test("an-empty-line-survives", "the wedge terminates a line it did nothing to") {
      $0200 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $00, "still an empty line")
    }

    ; ----------------------------------------------------------------------
    ; Dispatch. From here the tokens do not just exist, they run: the text goes
    ; through the wedge's own tokenizer, then TXTPTR is aimed just past the
    ; token and the statement handler is entered as IGONE would enter it.
    ;
    ; TXTPTR is left ON the token, which is exactly where IGONE's own CHRGET
    ; leaves it before it calls the handler. Setting it past the token instead
    ; looked equivalent and was not: it hid a bug where the handler re-read the
    ; token and tried to parse it as the target, which only a real machine
    ; showed.
    ; ----------------------------------------------------------------------

    ; UCI 1,1 - IDENTIFY on Ultimate DOS. It cannot fail, so it is the
    ; cheapest thing that proves the whole path: tokenize, dispatch, marshal,
    ; transport, and the reply landing where the observers read it.
    test("uci-statement-runs-a-command", "the generic statement reaches the device") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $31
      $0207 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "ULTIMATE_OK")
      assert([wedge_target] == $01, "target 1 was parsed")
      assert([wedge_command] == $01, "command 1 was parsed")
      assert([wedge_reply] == $55, "the reply starts 'U' of ULTIMATE")
    }

    ; Arguments. ECHO returns the command bytes verbatim, so it is the one
    ; command that can show what actually went on the wire - which is the only
    ; way to tell a marshalling bug from a transport one.
    test("uci-statement-marshals-byte-arguments", "one numeric argument is one byte") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $32
      $0207 = $34
      $0208 = $30
      $0209 = $2c
      $020a = $37
      $020b = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_command] == $f0, "240 is DOS_CMD_ECHO")
      assert([wedge_arglen] == $01, "one argument, one byte")
      assert([wedge_argbuf] == $07, "the argument byte")
      assert([wedge_reply] == $01, "ECHO replies with the target byte")
      assert(peekbyte([wedge_reply] + $01) == $f0, "then the command")
      assert(peekbyte([wedge_reply] + $02) == $07, "then the argument, as sent")
    }

    test("uci-uw-forces-a-16-bit-argument", "UW(300) is two bytes, LSB first, where the default rule would send one") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $32
      $0207 = $34
      $0208 = $30
      $0209 = $2c
      $020a = $55
      $020b = $57
      $020c = $28
      $020d = $33
      $020e = $30
      $020f = $30
      $0210 = $29
      $0211 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_arglen] == $02, "two bytes, not one")
      assert([wedge_argbuf] == $2c, "low byte of 300")
      assert(peekbyte([wedge_argbuf] + $01) == $01, "high byte")
      assert(peekbyte([wedge_reply] + $02) == $2c, "and that is what ECHO saw")
      assert(peekbyte([wedge_reply] + $03) == $01, "both bytes of it")
    }

    test("uci-ul-forces-a-32-bit-argument", "UL(100000) survives a value GETADR alone could not carry") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $32
      $0207 = $34
      $0208 = $30
      $0209 = $2c
      $020a = $55
      $020b = $4c
      $020c = $28
      $020d = $31
      $020e = $30
      $020f = $30
      $0210 = $30
      $0211 = $30
      $0212 = $30
      $0213 = $29
      $0214 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_arglen] == $04, "four bytes")
      assert([wedge_argbuf] == $a0, "100000 is $000186A0, LSB first")
      assert(peekbyte([wedge_argbuf] + $01) == $86, "...")
      assert(peekbyte([wedge_argbuf] + $02) == $01, "...")
      assert(peekbyte([wedge_argbuf] + $03) == $00, "...")
      assert(peekbyte([wedge_reply] + $02) == $a0, "and ECHO agrees")
      assert(peekbyte([wedge_reply] + $05) == $00, "to the last byte")
    }

    test("uci-marshals-a-string-argument", "a string contributes its bytes, with no length and no terminator") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $32
      $0207 = $34
      $0208 = $30
      $0209 = $2c
      $020a = $22
      $020b = $48
      $020c = $49
      $020d = $22
      $020e = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_arglen] == $02, "two characters, two bytes")
      assert([wedge_argbuf] == $48, "'H'")
      assert(peekbyte([wedge_argbuf] + $01) == $49, "'I'")
      assert(peekbyte([wedge_reply] + $02) == $48, "ECHO saw 'H'")
      assert(peekbyte([wedge_reply] + $03) == $49, "and 'I'")
    }

    test("uci-mixes-numbers-and-strings", "OPEN_FILE's shape: a byte then a name, which is the common case") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $32
      $0207 = $34
      $0208 = $30
      $0209 = $2c
      $020a = $31
      $020b = $2c
      $020c = $22
      $020d = $41
      $020e = $2e
      $020f = $50
      $0210 = $52
      $0211 = $47
      $0212 = $22
      $0213 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_arglen] == $06, "one byte plus five characters")
      assert([wedge_argbuf] == $01, "the attribute byte")
      assert(peekbyte([wedge_argbuf] + $01) == $41, "'A'")
      assert(peekbyte([wedge_argbuf] + $05) == $47, "'G' of PRG")
    }

    ; ----------------------------------------------------------------------
    ; Observers. These go through IEVAL, which is entered with TXTPTR sitting
    ; *before* the term - the ROM's handler does its own CHRGET - so the token
    ; goes at $0200 and the pointer one byte behind it.
    ; ----------------------------------------------------------------------

    ; A target constant. FAC holding 1.0 is exponent $81 with the mantissa
    ; normalised to $80, which is what "the wedge returned the number 1" looks
    ; like from outside.
    test("ueval-returns-a-target-constant", "UDOS1 evaluates to target 1") {
      $0200 = $d5
      $0201 = $00
      $007a = $ff
      $007b = $01
      jsr([wedge_eval], stop_on_rts = true, fail_on_brk = true)
      assert($0061 == $81, "FAC exponent for 1.0")
      assert($0062 == $80, "and its mantissa")
      assert($000d == $00, "a number, not a string")
    }

    test("ueval-returns-the-last-target-constant", "UHTTP is target 6") {
      $0200 = $da
      $0201 = $00
      $007a = $ff
      $007b = $01
      jsr([wedge_eval], stop_on_rts = true, fail_on_brk = true)
      assert($0061 == $83, "6.0 is 1.5 x 2^2")
      assert($0062 == $c0, "...with this mantissa")
    }

    ; UERR after a command that cannot fail. Zero is the one FAC value with a
    ; zero exponent, so this is unambiguous.
    test("ueval-uerr-is-zero-after-a-command-that-worked", "the observer reads the real result") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $31
      $0207 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "the command worked")
      $0200 = $cd
      $0201 = $00
      $007a = $ff
      $007b = $01
      jsr([wedge_eval], stop_on_rts = true, fail_on_brk = true)
      assert($0061 == $00, "UERR evaluated to zero")
      assert($000d == $00, "as a number")
    }

    ; UDAT$ has to come back as a string, and as a copy - the reply buffer is
    ; overwritten by the next command, and a BASIC string has to outlive that.
    test("ueval-udat-returns-a-string", "the reply reaches BASIC as a string value") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $31
      $0207 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      $0200 = $d1
      $0201 = $00
      $007a = $ff
      $007b = $01
      jsr([wedge_eval], stop_on_rts = true, fail_on_brk = true)
      assert($000d == $ff, "VALTYP says string")
    }

    ; A term the wedge does not own has to reach the ROM with TXTPTR exactly
    ; where it was, or every ordinary expression in every program breaks.
    test("ueval-hands-back-terms-it-does-not-own", "an ordinary number still evaluates") {
      $0200 = $37
      $0201 = $00
      $007a = $ff
      $007b = $01
      jsr([wedge_eval], stop_on_rts = true, fail_on_brk = true)
      assert($0061 == $83, "7.0")
      assert($0062 == $e0, "...with this mantissa")
      assert($000d == $00, "a number")
    }

    ; ----------------------------------------------------------------------
    ; Argument shapes. Everything above this point was the default rule - one
    ; number, one byte. These are the commands where that is wrong, and the
    ; generated table is what makes the natural thing work without UW().
    ; ----------------------------------------------------------------------


    test("shape-widens-a-16-bit-argument", "READ_DATA takes a length, and 8192 does not fit in a byte") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $34
      $0207 = $2c
      $0208 = $38
      $0209 = $31
      $020a = $39
      $020b = $32
      $020c = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_arglen] == $02, "the table said 16 bits, with no UW()")
      assert([wedge_argbuf] == $00, "8192 is $2000, LSB first")
      assert(peekbyte([wedge_argbuf] + $01) == $20, "...high byte")
    }

    test("shape-widens-a-32-bit-argument", "FILE_SEEK takes a 32-bit position, which a byte could never carry") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $36
      $0207 = $2c
      $0208 = $31
      $0209 = $30
      $020a = $30
      $020b = $30
      $020c = $30
      $020d = $30
      $020e = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_arglen] == $04, "four bytes, with no UL()")
      assert([wedge_argbuf] == $a0, "100000 is $000186A0, LSB first")
      assert(peekbyte([wedge_argbuf] + $01) == $86, "...")
      assert(peekbyte([wedge_argbuf] + $02) == $01, "...")
      assert(peekbyte([wedge_argbuf] + $03) == $00, "...")
    }

    test("shape-inserts-a-separator-the-caller-never-types", "RENAME is <old> $00 <new>, and the caller types two names") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $31
      $0207 = $30
      $0208 = $2c
      $0209 = $22
      $020a = $4f
      $020b = $4c
      $020c = $44
      $020d = $22
      $020e = $2c
      $020f = $22
      $0210 = $4e
      $0211 = $45
      $0212 = $57
      $0213 = $22
      $0214 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_arglen] == $07, "three plus a separator plus three")
      assert([wedge_argbuf] == $4f, "'O'")
      assert(peekbyte([wedge_argbuf] + $02) == $44, "'D'")
      assert(peekbyte([wedge_argbuf] + $03) == $00, "the separator the table knew about")
      assert(peekbyte([wedge_argbuf] + $04) == $4e, "'N'")
      assert(peekbyte([wedge_argbuf] + $06) == $57, "'W'")
    }

    test("shape-emits-leading-literals", "WRITE_DATA skips two bytes before the data, and the caller should not have to know") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $35
      $0207 = $2c
      $0208 = $22
      $0209 = $48
      $020a = $49
      $020b = $22
      $020c = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_arglen] == $04, "two ignored bytes then the data")
      assert([wedge_argbuf] == $00, "the first byte the firmware skips")
      assert(peekbyte([wedge_argbuf] + $01) == $00, "and the second")
      assert(peekbyte([wedge_argbuf] + $02) == $48, "'H'")
      assert(peekbyte([wedge_argbuf] + $03) == $49, "'I'")
    }

    test("shape-covers-the-second-dos-target", "DOS is one command set on two targets, and the table stores it once") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $32
      $0205 = $2c
      $0206 = $34
      $0207 = $2c
      $0208 = $38
      $0209 = $31
      $020a = $39
      $020b = $32
      $020c = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_target] == $02, "sent to target 2")
      assert([wedge_arglen] == $02, "but shaped like target 1")
      assert(peekbyte([wedge_argbuf] + $01) == $20, "...high byte of 8192")
    }

    test("uw-overrides-what-the-table-says", "the escape has to keep working for firmware newer than the table") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $34
      $0207 = $2c
      $0208 = $55
      $0209 = $57
      $020a = $28
      $020b = $33
      $020c = $30
      $020d = $30
      $020e = $29
      $020f = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_arglen] == $02, "still two bytes")
      assert([wedge_argbuf] == $2c, "but the value the caller forced")
      assert(peekbyte([wedge_argbuf] + $01) == $01, "...")
    }

    test("a-command-with-no-entry-keeps-the-default-rule", "most commands have no entry at all, and must stay one byte per number") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $32
      $0207 = $34
      $0208 = $30
      $0209 = $2c
      $020a = $37
      $020b = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_arglen] == $01, "one number, one byte")
      assert([wedge_argbuf] == $07, "as typed")
    }

    ; ----------------------------------------------------------------------
    ; What the ROM's caller gets back.
    ;
    ; CRUNCH does not just leave a tokenised line: it returns its length in Y,
    ; and main1 does `sty count` and stores the program line by it. A handler
    ; that treats Y as scratch corrupts every numbered line that is typed,
    ; while direct mode - which ignores Y - keeps working. That is what these
    ; pin, and it is what real hardware found: every emulator test above passed
    ; while typing a program on a real C64 did not work.
    ; ----------------------------------------------------------------------

    test("crunch-returns-the-length-for-a-line-it-did-not-touch", "an ordinary line is handed back exactly as the ROM would") {
      $0200 = $50
      $0201 = $52
      $0202 = $49
      $0203 = $4e
      $0204 = $54
      $0205 = $20
      $0206 = $32
      $0207 = $2b
      $0208 = $33
      $0209 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $99, "PRINT survived")
      assert($0203 == $aa, "and the '+' token")
      assert(y == $0a, "Y is what NCRNCH alone would have returned")
    }

    ; The same line through the ROM on its own, so the number above is the
    ; ROM's and not one this suite invented.
    test("the-rom-alone-returns-the-same-length", "the control for the assertion above") {
      $0200 = $50
      $0201 = $52
      $0202 = $49
      $0203 = $4e
      $0204 = $54
      $0205 = $20
      $0206 = $32
      $0207 = $2b
      $0208 = $33
      $0209 = $00
      $007a = $00
      $007b = $02
      jsr($a57c, stop_on_rts = true, fail_on_brk = true)
      assert(y == $0a, "NCRNCH's own answer")
    }

    ; A substituted line is shorter, and Y has to shrink by exactly as much or
    ; the stored line runs past its end.
    test("crunch-shortens-the-length-when-it-substitutes", "three bytes became one, so Y drops by two") {
      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $31
      $0207 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $cc, "UCI became one token")
      assert(y == $0a, "and Y came down from the ROM's $0c")
    }

    ; ----------------------------------------------------------------------
    ; UTURBO - the one keyword that does not reach the Ultimate over UCI.
    ;
    ; $D031 is ordinary read/write memory under this backend rather than a VIC
    ; returning $FF for its unimplemented registers, which is what makes the
    ; whole keyword testable here: the register can be put in any state and the
    ; statement and the function checked against it. That the machine really
    ; runs faster is tests/hardware/ucitest.c, on an Ultimate 64 that has turbo.
    ; ----------------------------------------------------------------------

    test("tokenize-uturbo", "UTURBO becomes one token with its argument intact") {
      $0200 = $55
      $0201 = $54
      $0202 = $55
      $0203 = $52
      $0204 = $42
      $0205 = $4f
      $0206 = $20
      $0207 = $33
      $0208 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $db, "UTURBO tokenized")
      assert($0201 == $20, "the space survived")
      assert($0202 == $33, "and so did the 3")
      assert($0203 == $00, "line terminated")
    }

    test("uturbo-statement-sets-the-speed", "the statement writes the index and nothing else") {
      $d031 = $86                       ; 8MHz-ish, badlines already off
      $0200 = $55
      $0201 = $54
      $0202 = $55
      $0203 = $52
      $0204 = $42
      $0205 = $4f
      $0206 = $20
      $0207 = $33
      $0208 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_turbo], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "ULTIMATE_OK")
      assert($d031 == $83, "speed 3, and the badline bit untouched")
    }

    ; The common case in the field: the machine's owner has left turbo off, so
    ; the register reads $FF and there is nothing a program can do about it
    ; except notice. UERR is how it notices.
    test("uturbo-statement-reports-no-turbo", "UERR carries the refusal") {
      $d031 = $ff
      $0200 = $55
      $0201 = $54
      $0202 = $55
      $0203 = $52
      $0204 = $42
      $0205 = $4f
      $0206 = $20
      $0207 = $33
      $0208 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_turbo], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")
      assert($d031 == $ff, "and nothing was written")
    }

    ; The function form, sharing the statement's token. IEVAL is entered with
    ; TXTPTR before the term, so the token goes at $0200 and the pointer one
    ; byte behind it - same as the observers above.
    test("uturbo-function-reads-the-speed", "UTURBO evaluates to the current index") {
      $d031 = $86
      $0200 = $db
      $0201 = $00
      $007a = $ff
      $007b = $01
      jsr([wedge_eval], stop_on_rts = true, fail_on_brk = true)
      assert($0061 == $83, "6.0 is 1.5 x 2^2")
      assert($0062 == $c0, "...with this mantissa, so the badline bit is not in it")
      assert($000d == $00, "a number, not a string")
    }

    ; --- UREU ---

    test("tokenize-ureu", "UREU becomes one token") {
      $0200 = $55                       ; "UREU"
      $0201 = $52
      $0202 = $45
      $0203 = $55
      $0204 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $e2, "UREU tokenized")
      assert($0201 == $00, "and the line ends right after it")
    }

    ; **Zero is the answer here, and it is the right one.** u64sim has plain RAM
    ; where the REU registers live, so the presence probe passes - two patterns
    ; written and read back - but no transfer ever reports done, so the size
    ; probe cannot get a byte in or out and says there is no expansion. That is
    ; exactly the contract: UREU is 0 when there is nothing usable.
    ;
    ; The eight real sizes are proved in tests/hardware, against a machine whose
    ; expansion is configured from outside and has to agree. A simulator with
    ; RAM at $DF02 can no more size an REU than detect one; see reu.s.
    test("ureu-is-zero-without-a-working-expansion", "0 means none, and it is a number") {
      $0200 = $e2
      $0201 = $00
      $007a = $ff
      $007b = $01
      jsr([wedge_eval], stop_on_rts = true, fail_on_brk = true)
      assert($0061 == $00, "FAC1 exponent zero: the value is 0")
      assert($000d == $00, "a number, not a string")
    }

    ; --- the file keywords ---
    ;
    ; ULOAD, UBLOAD and USAVE do not arrive as the text that was typed. CRUNCH
    ; matches a reserved word anywhere, so LOAD and SAVE inside them are already
    ; tokens by the time the wedge looks, and the patterns it matches are those
    ; crunched forms. tools/gen_keywords.py works them out; this is the proof
    ; that what it worked out is what the ROM really produces.

    ; **Every statement below resets the stack first.** BASIC's own loop
    ; unwinds between statements and these tests do not have one: they call a
    ; handler directly, and FRMEVL leaves the stack deeper than it found it, so
    ; the third string argument in a test would fail on stack rather than on
    ; anything the wedge did. $A67A is the ROM's own stack reset, which the
    ; setup above already calls once for the same reason.

    test("tokenize-the-file-keywords", "a keyword with a keyword inside it still becomes one token") {
      $0200 = $55
      $0201 = $4c
      $0202 = $4f
      $0203 = $41
      $0204 = $44
      $0205 = $20
      $0206 = $22
      $0207 = $58
      $0208 = $22
      $0209 = $2c
      $020a = $31
      $020b = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $dc, "ULOAD is one token, not 'U' and a LOAD")
      assert($0201 == $20, "and the rest of the line survived")

      $0200 = $55
      $0201 = $42
      $0202 = $4c
      $0203 = $4f
      $0204 = $41
      $0205 = $44
      $0206 = $20
      $0207 = $22
      $0208 = $58
      $0209 = $22
      $020a = $2c
      $020b = $31
      $020c = $2c
      $020d = $32
      $020e = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $dd, "UBLOAD, whose crunched form is 'U' 'B' and LOAD")

      $0200 = $55
      $0201 = $53
      $0202 = $41
      $0203 = $56
      $0204 = $45
      $0205 = $20
      $0206 = $22
      $0207 = $58
      $0208 = $22
      $0209 = $2c
      $020a = $31
      $020b = $2c
      $020c = $32
      $020d = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $de, "USAVE, which contains SAVE")

      $0200 = $55
      $0201 = $44
      $0202 = $49
      $0203 = $52
      $0204 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $df, "UDIR, which contains nothing the ROM knows")
      assert($0201 == $00, "and takes no arguments")

      $0200 = $55
      $0201 = $53
      $0202 = $54
      $0203 = $41
      $0204 = $53
      $0205 = $48
      $0206 = $20
      $0207 = $31
      $0208 = $2c
      $0209 = $32
      $020a = $2c
      $020b = $33
      $020c = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $e0, "USTASH")

      $0200 = $55
      $0201 = $46
      $0202 = $45
      $0203 = $54
      $0204 = $43
      $0205 = $48
      $0206 = $20
      $0207 = $31
      $0208 = $2c
      $0209 = $32
      $020a = $2c
      $020b = $33
      $020c = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      assert($0200 == $e1, "UFETCH")
    }

    ; The names below are poked in as lowercase ASCII, which is not what a user
    ; types. On a real machine typing `big.bin` produces PETSCII $42 $49 $47 -
    ; the same bytes as ASCII "BIG" - and FAT lookup does not care about case,
    ; so it finds the file. u64sim's directory is a real one on a Linux host,
    ; which does care, so these send what that filesystem needs. The wedge
    ; passes a name through byte for byte either way, and that is the property
    ; being tested here.

    test("uload-loads-a-file", "the PRG header is consumed, the rest is in memory") {
      $cb00 = $ff
      $0200 = $55
      $0201 = $4c
      $0202 = $4f
      $0203 = $41
      $0204 = $44
      $0205 = $20
      $0206 = $22
      $0207 = $62
      $0208 = $69
      $0209 = $67
      $020a = $2e
      $020b = $62
      $020c = $69
      $020d = $6e
      $020e = $22
      $020f = $2c
      $0210 = $35
      $0211 = $31
      $0212 = $39
      $0213 = $36
      $0214 = $38
      $0215 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      jsr($a67a, stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_load], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "ULTIMATE_OK")
      ; big.bin counts up from zero, so $00 $01 were its load address and were
      ; eaten. The first byte stored is the third of the file.
      assert($cb00 == $02, "the header is gone, not merely skipped over")
      assert($cb01 == $03, "and the file follows it")
    }

    test("ubload-strips-nothing-and-stops-at-the-limit", "raw is raw") {
      $cb00 = $ff
      $cb08 = $aa
      $0200 = $55
      $0201 = $42
      $0202 = $4c
      $0203 = $4f
      $0204 = $41
      $0205 = $44
      $0206 = $20
      $0207 = $22
      $0208 = $62
      $0209 = $69
      $020a = $67
      $020b = $2e
      $020c = $62
      $020d = $69
      $020e = $6e
      $020f = $22
      $0210 = $2c
      $0211 = $35
      $0212 = $31
      $0213 = $39
      $0214 = $36
      $0215 = $38
      $0216 = $2c
      $0217 = $38
      $0218 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      jsr($a67a, stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_bload], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "ULTIMATE_OK")
      assert($cb00 == $00, "byte zero of the file, header and all")
      assert($cb01 == $01, "then one")
      assert($cb08 == $aa, "and nothing past the eight bytes asked for")
    }

    ; USAVE, then the generic form to take the file away again: the wedge has no
    ; delete keyword, and the test data policy in docs/handover.md section 6 says
    ; every mutating test cleans up after itself.
    test("usave-writes-what-was-asked-for", "memory becomes a file") {
      $cb00 = $de
      $cb01 = $ad
      $cb02 = $be
      $cb03 = $ef
      $0200 = $55
      $0201 = $53
      $0202 = $41
      $0203 = $56
      $0204 = $45
      $0205 = $20
      $0206 = $22
      $0207 = $64
      $0208 = $61
      $0209 = $74
      $020a = $61
      $020b = $2f
      $020c = $73
      $020d = $76
      $020e = $2e
      $020f = $74
      $0210 = $6d
      $0211 = $70
      $0212 = $22
      $0213 = $2c
      $0214 = $35
      $0215 = $31
      $0216 = $39
      $0217 = $36
      $0218 = $38
      $0219 = $2c
      $021a = $34
      $021b = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      jsr($a67a, stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_save], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "ULTIMATE_OK")

      ; Read it back through UBLOAD, over a wiped buffer, so the assertion
      ; cannot pass on the bytes that were already there.
      $cb00 = $00
      $cb01 = $00
      $cb02 = $00
      $cb03 = $00
      $0200 = $55
      $0201 = $42
      $0202 = $4c
      $0203 = $4f
      $0204 = $41
      $0205 = $44
      $0206 = $20
      $0207 = $22
      $0208 = $64
      $0209 = $61
      $020a = $74
      $020b = $61
      $020c = $2f
      $020d = $73
      $020e = $76
      $020f = $2e
      $0210 = $74
      $0211 = $6d
      $0212 = $70
      $0213 = $22
      $0214 = $2c
      $0215 = $35
      $0216 = $31
      $0217 = $39
      $0218 = $36
      $0219 = $38
      $021a = $2c
      $021b = $34
      $021c = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      jsr($a67a, stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_bload], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "and it reads back")
      assert($cb00 == $de, "byte for byte")
      assert($cb03 == $ef, "all four of them")

      $0200 = $55
      $0201 = $43
      $0202 = $49
      $0203 = $20
      $0204 = $31
      $0205 = $2c
      $0206 = $39
      $0207 = $2c
      $0208 = $22
      $0209 = $64
      $020a = $61
      $020b = $74
      $020c = $61
      $020d = $2f
      $020e = $73
      $020f = $76
      $0210 = $2e
      $0211 = $74
      $0212 = $6d
      $0213 = $70
      $0214 = $22
      $0215 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      jsr($a67a, stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_uci], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "and the fixture tree is as it was found")
    }

    ; UDIR prints as it walks, because it has to: the firmware answers READ_DIR
    ; with one reply block per entry and the block boundary is the only
    ; separator, so no other command may go out between calls. So what it wrote
    ; is the only evidence of what it read.
    ;
    ; **The bytes are captured at the KERNAL vector, not read off the screen.**
    ; Bringing the screen editor up means $FF81, and $FF81 does not return under
    ; this backend - it waits on hardware the simulator does not model. IBSOUT
    ; at $0326 is where BASIC's OUTDO ends up either way, so a six-instruction
    ; stub in the cassette buffer collects exactly what the wedge emitted, in
    ; PETSCII, before anything draws it.
    ;
    ;     $033c  stx $0390      ; CHROUT preserves X, so this does too
    ;            ldx $0391      ; how many bytes so far
    ;            sta $0380,x
    ;            inc $0391
    ;            ldx $0390
    ;            clc            ; carry set is an I/O error, and BASIC's OUTDO
    ;            rts            ; goes through $E10C, which acts on it

    test("udir-prints-the-directory", "one entry per line, converted on the way out") {
      $033c = $8e
      $033d = $90
      $033e = $03
      $033f = $ae
      $0340 = $91
      $0341 = $03
      $0342 = $9d
      $0343 = $80
      $0344 = $03
      $0345 = $ee
      $0346 = $91
      $0347 = $03
      $0348 = $ae
      $0349 = $90
      $034a = $03
      $034b = $18
      $034c = $60
      $0391 = $00               ; nothing collected yet
      $0326 = $3c               ; IBSOUT, the KERNAL's character-out vector
      $0327 = $03

      $0200 = $55
      $0201 = $44
      $0202 = $49
      $0203 = $52
      $0204 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      jsr($a67a, stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_dir], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "the walk ended with ULTIMATE_END, which is not an error")

      ; "data", folded up out of ASCII lowercase so CHROUT draws letters and not
      ; graphics symbols, then the slash that says it is a directory.
      assert($0391 == $0e, "fourteen bytes went out and no more")
      assert($0380 == $44, "'d' of data")
      assert($0381 == $41, "'a'")
      assert($0382 == $54, "'t'")
      assert($0383 == $41, "'a'")
      assert($0384 == $2f, "'/' - it is a directory and says so")
      assert($0385 == $0d, "and the line ends")

      assert($0386 == $42, "'b' of big.bin")
      assert($0387 == $49, "'i'")
      assert($0388 == $47, "'g'")
      assert($0389 == $2e, "'.'")
      assert($038a == $42, "'b'")
      assert($038b == $49, "'i'")
      assert($038c == $4e, "'n'")
      assert($038d == $0d, "a file gets no slash, just the line end")
    }

    ; --- the RAM expansion ---
    ;
    ; $DF00-$DF0A is ordinary memory under sim6502, so what these prove is the
    ; arithmetic: that a 24-bit REU address survives BASIC's floating point,
    ; that the C64 address and the length land in the right register pairs, and
    ; that stash and fetch differ by exactly the mode bit. The transfer itself
    ; is tests/hardware/ucitest.c, on a machine with an expansion in it.

    test("ustash-programs-the-registers", "a 24-bit address survives the trip through BASIC") {
      $df00 = $40               ; REU_STAT_DONE, so the SDK sees it finish
      $0200 = $55
      $0201 = $53
      $0202 = $54
      $0203 = $41
      $0204 = $53
      $0205 = $48
      $0206 = $20
      $0207 = $35
      $0208 = $31
      $0209 = $39
      $020a = $36
      $020b = $38
      $020c = $2c
      $020d = $37
      $020e = $34
      $020f = $35
      $0210 = $36
      $0211 = $35
      $0212 = $2c
      $0213 = $32
      $0214 = $35
      $0215 = $36
      $0216 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      jsr($a67a, stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_stash], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "ULTIMATE_OK")
      assert($df02 == $00, "C64 address low: 51968 is $cb00")
      assert($df03 == $cb, "...and high")
      assert($df04 == $45, "REU address low: 74565 is $012345")
      assert($df05 == $23, "...middle")
      assert($df06 == $01, "...and the third byte, which GETADR could not have carried")
      assert($df07 == $00, "length low: 256")
      assert($df08 == $01, "...and high")
      assert($df01 == $90, "EXECUTE and NOW, mode 00: C64 to REU")
    }

    test("ufetch-is-the-other-direction", "one bit apart, and it is the right bit") {
      $df00 = $40
      $0200 = $55
      $0201 = $46
      $0202 = $45
      $0203 = $54
      $0204 = $43
      $0205 = $48
      $0206 = $20
      $0207 = $34
      $0208 = $39
      $0209 = $31
      $020a = $35
      $020b = $32
      $020c = $2c
      $020d = $30
      $020e = $2c
      $020f = $31
      $0210 = $36
      $0211 = $00
      $007a = $00
      $007b = $02
      jsr([wedge_crunch], stop_on_rts = true, fail_on_brk = true)
      jsr($a67a, stop_on_rts = true, fail_on_brk = true)
      $007a = $00
      $007b = $02
      jsr([wedge_do_fetch], stop_on_rts = true, fail_on_brk = true)
      assert([wedge_err] == $00, "ULTIMATE_OK")
      assert($df03 == $c0, "C64 address high: 49152 is $c000")
      assert($df04 == $00, "REU address zero, all three bytes")
      assert($df05 == $00, "...")
      assert($df06 == $00, "...")
      assert($df07 == $10, "sixteen bytes")
      assert($df01 == $91, "mode 01: REU to C64")
    }

    test("uturbo-function-reports-no-turbo", "255 is not a speed, so it can be tested for") {
      $d031 = $ff
      $0200 = $db
      $0201 = $00
      $007a = $ff
      $007b = $01
      jsr([wedge_eval], stop_on_rts = true, fail_on_brk = true)
      assert($0061 == $88, "255.0 is 0.99609375 x 2^8")
      assert($0062 == $ff, "...with this mantissa")
    }

  }
}
