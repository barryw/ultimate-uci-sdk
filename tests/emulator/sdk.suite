; sdk.suite - the SDK's assembled 6502 code against a simulated Ultimate.
;
; This is where the shipping binary is exercised: real 6502 instructions, real
; registers, a device that makes the code wait. Everything the SDK promises that
; can be reached without hardware is asserted here.
;
;   make run
;
; The suite runs twice - once as built, once against a build with the SDK's RAM
; relocated (sdk-placed.suite, generated) - so "placeable" stays a tested
; property rather than a claim in the documentation.
;
; Two things it cannot reach, and why:
;   - no device at all           absent.suite, which loads the same program
;                                under a backend with no UCI on the bus
;   - a device that never answers timeout.suite, which raises the simulated
;                                interface latency past the SDK's budget
;
; SPDX-License-Identifier: MIT

suites {
  suite("ultimate sdk on 6502") {
    system(c64)
    symbols("/code/tests/emulator/harness.sym")
    load("/code/tests/emulator/harness.prg", strip_header = true)

    ; Every variable a test reads back starts as $FF rather than as whatever
    ; the loader happened to leave. Around twenty assertions here were
    ; non-vacuous only by accident: the harness's BSS overlaps cc65's ONCE
    ; segment, so `result` and the capability block held non-zero bytes before
    ; each test - and if that overlap ever moved, a whole class of
    ; `assert(... == $00)` would go quietly vacuous with nothing failing.
    ;
    ; The nine bytes are result, devcode, reply_len and the four-byte
    ; capability block, in the order harness.s declares them.
    setup {
      memfill([result], 9, $ff)
    }

    ; ---------------------------------------------------------------- bring-up

    test("sdk-signature", "the signature is on the bus and readable without blocking") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_present], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $01, "uci_present sees the interface")
      jsr([t_ident_reg], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $c9, "UCI_IDENT_IDLE: no interrupt pending")
    }

    test("sdk-init", "ultimate_init finds the interface and returns OK") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      jsr([t_available], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $01, "ultimate_available follows a successful init")
    }

    ; The bounded-time guarantee has to hold for a program that never calls
    ; uci_set_timeout - and with UCI_VARS the variables are in RAM the caller
    ; owns, which nothing zeroes. So bring-up installs the budget.
    test("sdk-default-timeout", "init installs the default timeout budget") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      [timeout_val] = $00
      jsr([t_set_timeout], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_get_timeout], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $c8, "UCI_TIMEOUT_DEFAULT, not the zero we left behind")
    }

    ; A program that died mid-command leaves bytes in the command queue that
    ; nothing in the status register exposes. Abort is what rewinds the write
    ; pointer, and init is what issues it.
    test("sdk-init-rewinds-command", "init discards command bytes a dead program left behind") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      $df1d = $aa                       ; written, never pushed
      $df1d = $bb
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")

      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $01
      [req_command] = $f0               ; ECHO returns the command bytes verbatim
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([req_datalen].w == $0002, "two bytes: the leftovers are gone")
      assert([buf_data] == $01, "target byte first, not the stray $aa")
    }

    test("sdk-init-recovers-data-state", "init recovers an exchange the previous program abandoned") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_wedge], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")

      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $01
      [req_command] = $f0
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the next command still works")
      assert([req_datalen].w == $0002, "and its reply is its own, not the abandoned one")
    }

    ; docs/asm-abi.md claims the assembly entry points need no C runtime. This
    ; is that claim, executed: the cc65 software stack pointer is nulled first,
    ; so anything reaching for it writes through a null pointer into the 6510's
    ; port registers at $00/$01 rather than quietly working by accident.
    test("sdk-assembly-abi", "the assembly entry points do not touch the cc65 stack") {
      jsr([t_break_cstack], stop_on_rts = true, fail_on_brk = true)

      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ultimate_init")

      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $01
      [req_command] = $f0
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "uci_exec")
      assert([buf_data] == $01, "and its reply arrived")

      [ident_target] = $01
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00
      jsr([t_identify], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ultimate_identify")
      assert([reply0] == $55, "'U'")

      jsr([t_get_model], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ultimate_get_model")

      ; u64sim's deprecated GET_HWINFO predates the SID selector and returns the model for
      ; every argument. The SDK must reject that text as a malformed SID frame
      ; and leave the caller with zero records.
      [sid_info] = $ff
      jsr([t_sid_info], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $03, "ultimate_legacy_get_sid_info rejects a malformed reply")
      assert([sid_info] == $00, "and clears the count")

      jsr([t_sid_info_null], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ultimate_legacy_get_sid_info rejects a null pointer")
    }

    ; ---------------------------------------------------------------- exchange

    test("sdk-exec-encodes-command", "target, command, arguments and payload reach the wire in order") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)

      [req_target] = $01
      [req_command] = $f0
      [buf_args] = $de
      [buf_args] + $01 = $ad
      [req_arglen] = $02
      [buf_payload] = $be
      [buf_payload] + $01 = $ef
      [req_payloadlen] = $02

      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([req_datalen].w == $0006, "six bytes echoed back")
      assert([buf_data] == $01, "target")
      assert(([buf_data] + $01).b == $f0, "command")
      assert(([buf_data] + $02).b == $de, "arguments, in order")
      assert(([buf_data] + $03).b == $ad, "...")
      assert(([buf_data] + $04).b == $be, "then the payload, after the arguments")
      assert(([buf_data] + $05).b == $ef, "...")
      assert([req_statuslen].w == $0005, "00,OK")
      assert([buf_status] == $30, "'0'")
      assert([devcode].w == $0000, "device code 0")
    }

    test("sdk-exec-truncation", "a reply that does not fit is reported, and the exchange still finishes") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)

      [req_target] = $01
      [req_command] = $f0
      [buf_args] = $01
      [buf_args] + $01 = $02
      [buf_args] + $02 = $03
      [buf_args] + $03 = $04
      [req_arglen] = $04
      [req_datamax] = $04               ; room for four of the six bytes
      [req_datamax] + $01 = $00

      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $08, "ULTIMATE_ERR_TRUNCATED")
      assert([req_datalen].w == $0004, "the buffer was filled, not overrun")
      assert(([buf_data] + $04).b == $00, "and nothing was written past it")

      ; Truncating must leave the interface usable, not half way through a
      ; transfer: the rest of the reply is drained and discarded.
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $01
      [req_command] = $f0
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the next command succeeds")
      assert([req_datalen].w == $0002, "with its own reply")
    }

    ; Asking for no data is deliberate. Reporting it as truncation would make
    ; every fire-and-forget command look like a failure.
    test("sdk-exec-discards-reply", "a caller with no data buffer is not a truncated caller") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)

      [req_target] = $01
      [req_command] = $f0
      [req_data] = $00
      [req_data] + $01 = $00
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK, not ULTIMATE_ERR_TRUNCATED")
      assert([req_datalen].w == $0000, "nothing stored")
    }

    test("sdk-exec-device-error", "a failing command reports the device's own code") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)

      [req_target] = $01
      [req_command] = $04               ; READ_DATA with no file open
      [buf_args] = $10
      [buf_args] + $01 = $00
      [req_arglen] = $02

      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
      assert([devcode].w == 85, "85,NO FILE OPEN")
      assert([buf_status] == $38, "'8'")
      assert(([buf_status] + $01).b == $35, "'5'")
    }

    ; The numeric prefix is captured internally, never re-read from the caller's
    ; copy. Decoding a two-byte copy of "85,NO FILE OPEN" would see "85" here by
    ; luck, but a three-digit HTTP status would decode as its first two digits.
    test("sdk-exec-short-status-buffer", "a short status buffer does not change how the status is read") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)

      [req_target] = $01
      [req_command] = $04
      [buf_args] = $10
      [buf_args] + $01 = $00
      [req_arglen] = $02
      [req_statusmax] = $02
      [req_statusmax] + $01 = $00

      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
      assert([devcode].w == 85, "the full prefix was decoded")
      assert([req_statuslen].w == $0002, "the caller still only got two bytes")
      assert(([buf_status] + $02).b == $00, "and nothing past them")
    }

    ; DOS_CMD_READ_DATA arrives in 512-byte blocks, so anything longer walks the
    ; DATA_MORE chain. big.bin is 600 bytes of i mod 256.
    test("sdk-exec-multi-block", "a reply longer than one block is stitched back together") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)

      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $01
      [req_command] = $02               ; OPEN_FILE
      [buf_args] = $01                  ; attribute: read
      [buf_args] + $01 = $2f            ; "/Usb0/big.bin"
      [buf_args] + $02 = $55
      [buf_args] + $03 = $73
      [buf_args] + $04 = $62
      [buf_args] + $05 = $30
      [buf_args] + $06 = $2f
      [buf_args] + $07 = $62
      [buf_args] + $08 = $69
      [buf_args] + $09 = $67
      [buf_args] + $0a = $2e
      [buf_args] + $0b = $62
      [buf_args] + $0c = $69
      [buf_args] + $0d = $6e
      [req_arglen] = $0e
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "OPEN_FILE succeeded")

      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $01
      [req_command] = $04               ; READ_DATA, 600 bytes
      [buf_args] = $58
      [buf_args] + $01 = $02
      [req_arglen] = $02
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([req_datalen].w == 600, "both blocks, counted once")
      assert([buf_data] == $00, "byte 0")
      assert(([buf_data] + $ff).b == $ff, "byte 255, the end of the first block")
      assert(([buf_data] + $100).b == $00, "byte 256")
      assert(([buf_data] + $1ff).b == $ff, "byte 511, the last byte of block one")
      assert(([buf_data] + $200).b == $00, "byte 512, the first of block two")
      assert(([buf_data] + $257).b == $57, "byte 599, the last byte of the file")

      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $01
      [req_command] = $03               ; CLOSE_FILE
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "CLOSE_FILE succeeded")
    }

    ; The largest command the hardware can receive: two header bytes and 893
    ; arguments. One more would be dropped by the command pointer, and the
    ; Ultimate would be told the command was shorter than it was.
    ;
    ; The 895-byte reply is also the closest the SDK can get to filling the
    ; 896-byte response queue, which is where DATA_AV would stick set for ever.
    ; It cannot reach the exact case, because it refuses to send the 896th
    ; command byte - the bounded drain in uci_read_block is what makes both
    ; terminate.
    test("sdk-exec-largest-command", "the largest legal command is sent whole and read back whole") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)

      memfill([buf_args], 893, $5a)
      [req_target] = $01
      [req_command] = $f0
      [req_arglen] = $7d                ; 893 = $037d
      [req_arglen] + $01 = $03

      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([req_datalen].w == $037f, "895 bytes: UCI_MAX_COMMAND_USABLE")
      assert([buf_data] == $01, "target")
      assert(([buf_data] + $01).b == $f0, "command")
      assert(memchk([buf_data] + $02, 893, $5a), "every argument byte came back")
    }

    ; A fire-and-forget command returns as soon as the interface is idle again.
    ; CTRL_CMD_FREEZE is the real case: it only completes when the user leaves
    ; the Ultimate's menu, so waiting for a reply would hang the caller.
    test("sdk-exec-no-reply", "the NO_REPLY flag skips the data phase") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)

      [req_target] = $84                ; UCI_TARGET_CONTROL | UCI_TARGET_NO_REPLY
      [req_command] = $05               ; CTRL_CMD_FREEZE
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([req_datalen].w == $0000, "no data phase")
      assert([req_statuslen].w == $0000, "no status phase")
    }

    ; -------------------------------------------------------------- validation

    test("sdk-exec-rejects-no-target", "target zero is a caller bug, not an I/O error") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $00
      [req_command] = $01
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
    }

    test("sdk-exec-rejects-length-without-pointer", "a length with a null pointer is rejected") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $01
      [req_command] = $01
      [req_args] = $00
      [req_args] + $01 = $00
      [req_arglen] = $04
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
    }

    test("sdk-exec-rejects-oversized-command", "one byte over the limit is refused, not silently clipped") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $01
      [req_command] = $01
      [req_arglen] = $7e                ; 2 + 894 = 896, one too many
      [req_arglen] + $01 = $03
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
    }

    ; The sum, and only the sum. Both lengths below are legal on their own -
    ; 800 is under the 895-byte maximum - so this fails only if the total is
    ; checked as well as the parts.
    ;
    ; A 16-bit wrap ($8000 + $8000 + 2 = 2) is unreachable and is deliberately
    ; not tested: each length is rejected against the maximum before the sum is
    ; computed, so no pair that wraps ever reaches the addition. A test using
    ; those values passes on the first bound and proves nothing about the
    ; second, which is what this one used to do.
    test("sdk-exec-rejects-a-total-that-does-not-fit", "two legal lengths can still be too much together") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_req_reset], stop_on_rts = true, fail_on_brk = true)
      [req_target] = $01
      [req_command] = $01
      [req_arglen] = $20                ; 800 bytes of arguments
      [req_arglen] + $01 = $03
      [req_payloadlen] = $20            ; and 800 of payload: 1602 with the
      [req_payloadlen] + $01 = $03      ; target and command bytes
      jsr([t_exec], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
      assert([req_datalen].w == $0000, "and nothing went on the wire")
    }

    ; -------------------------------------------------------------------- net

    ; u64sim implements no network command, so what these pin is the half of
    ; net.s that never reaches the wire. The sockets that carry bytes are in
    ; tests/hardware, against the Ultimate's own web server - see docs/uci.md.

    test("sdk-net-read-refuses-a-null-buffer", "a caller bug, caught before the wire") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [result] = $ff
      jsr([t_net_read_null], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
      assert([net_got].w == $0000, "and nothing is claimed to have arrived")
    }

    ; The firmware sends a 16-bit count in front of the data, so a buffer that
    ; can hold only the count has no room for a single byte of payload. Asking
    ; anyway would truncate every read.
    test("sdk-net-read-refuses-a-buffer-with-no-room", "two bytes is the count and nothing else") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [result] = $ff
      jsr([t_net_read_tiny], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
    }

    test("sdk-net-write-refuses-a-null-buffer", "the same rule, sending") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [result] = $ff
      jsr([t_net_write_null], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
    }

    ; A failed open must not leave a handle behind: $FF is not a socket, so a
    ; caller that forgets to check the result closes nothing rather than
    ; closing whatever happened to be in the variable.
    test("sdk-net-connect-refuses-a-null-host", "and leaves no handle") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [net_sock] = $07
      [result] = $ff
      jsr([t_net_connect_null], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
      assert([net_sock] == $ff, "no socket was opened")
    }

    test("sdk-net-connect-refuses-an-empty-host", "a zero-length name is not a name") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [reply0] = $00
      [net_sock] = $07
      [result] = $ff
      jsr([t_net_connect], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
      assert([net_sock] == $ff, "no socket was opened")
    }

    ; The device this suite runs against has no network target, and that has to
    ; arrive as "not supported" rather than as a hang or a wrong success. It is
    ; the same path ultimate_identify takes for an absent target, reached
    ; through a service instead of through the generic form.
    test("sdk-net-on-a-device-without-the-target", "absent is answered, not waited for") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [net_iface] = $ff
      [result] = $00
      jsr([t_net_ifcount], stop_on_rts = true, fail_on_brk = true)
      assert([result] != $00, "the command did not succeed")
      assert([result] != $02, "and it did not time out waiting")
      assert([net_iface] == $00, "no interface count was invented")
    }

    ; ---------------------------------------------------------------- identity

    test("sdk-identify", "ultimate_identify reads the DOS version string") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_identify_dos1], stop_on_rts = true, fail_on_brk = true)

      assert([result] == $00, "ULTIMATE_OK")
      assert([reply0] == $55, "'U'")
      assert([reply1] == $4c, "'L'")
      assert([reply2] == $54, "'T'")
      assert([reply3] == $49, "'I'")
    }

    ; The interesting half of capability detection: recognising the firmware's
    ; placeholder reply and turning it into ULTIMATE_ERR_NOT_SUPPORTED rather
    ; than handing "NO TARGET" back as if it were a version string.
    test("sdk-absent-target", "an unimplemented target reports NOT SUPPORTED") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_identify_absent], stop_on_rts = true, fail_on_brk = true)

      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")
      assert([reply0] == $00, "the caller's buffer is left empty, not full of NO TARGET")
    }

    ; Firmware without a SoftwareIEC target still answers on $05, through the
    ; placeholder - in ASCII, while that target's own status format is a single
    ; binary byte. The data marker has to win or this reads as a device error.
    test("sdk-absent-softiec", "the NO TARGET marker beats the target's own status format") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      memfill([reply], 64, $ff)
      [ident_target] = $05
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00
      jsr([t_identify], stop_on_rts = true, fail_on_brk = true)

      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")
      assert([reply0] == $00, "an empty string, not NO TARGET")
      assert([reply_len].w == $0000, "and a length of zero")
    }

    test("sdk-identify-short-buffer", "identify clips instead of overflowing") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      memfill([reply], 64, $ff)
      [ident_target] = $01
      [ident_buflen] = $08
      [ident_buflen] + $01 = $00
      jsr([t_identify], stop_on_rts = true, fail_on_brk = true)

      assert([result] == $00, "clipping an identification string is not an error")
      assert([reply0] == $55, "'U'")
      assert(([reply] + $06).b == $54, "'T' of ULTIMAT")
      assert(([reply] + $07).b == $00, "terminated at buflen - 1")
      assert(([reply] + $08).b == $ff, "and nothing written past the buffer")
      assert([reply_len].w == $0007, "seven characters stored")
    }

    ; u64sim implements DOS on $01 and $02 and the control target on $04, and
    ; nothing else - so this is also a check that detection reports absence
    ; correctly, not just presence.
    test("sdk-detect", "capability probing finds exactly the targets that exist") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_detect], stop_on_rts = true, fail_on_brk = true)

      assert([result] == $00, "ULTIMATE_OK")
      assert([caps_present] == $01, "present")
      assert([caps_ident] == $c9, "identification register")
      assert([caps_targets_lo] == $16, "targets: DOS1, DOS2 and control")
      assert([caps_targets_hi] == $00, "nothing above target $07")
    }

    ; The model name is mixed case, unlike the uppercase identification strings.
    ; Anything printing it on a stock C64 has to fold or convert it first.
    test("sdk-get-model", "the control target names the machine") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $18
      [ident_buflen] + $01 = $00
      jsr([t_get_model], stop_on_rts = true, fail_on_brk = true)

      assert([result] == $00, "ULTIMATE_OK")
      assert([reply0] == $55, "'U'")
      assert([reply1] == $6c, "'l' - lower case, so the name is mixed case")
    }

    ; ------------------------------------------------------------ status codes

    test("sdk-status-format", "the encoding each target is expected to use") {
      [fmt_target] = $01
      jsr([t_status_fmt], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "DOS: UCI_STATUS_FMT_DECIMAL2")
      [fmt_target] = $03
      jsr([t_status_fmt], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "network: decimal2")
      [fmt_target] = $04
      jsr([t_status_fmt], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "control: decimal2")
      [fmt_target] = $06
      jsr([t_status_fmt], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $01, "HTTP: UCI_STATUS_FMT_DECIMAL3")
      [fmt_target] = $05
      jsr([t_status_fmt], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $02, "SoftwareIEC: UCI_STATUS_FMT_BINARY")
    }

    ; 00 is success; 01 and 02 are advisory - the command did what was asked and
    ; has something to add. Reporting those as failures would break working
    ; programs.
    test("sdk-decode-decimal2", "NN,TEXT decoding") {
      [dec_target] = $01
      [dec_len] = $05
      [dec_buf] = $30
      [dec_buf] + $01 = $30
      [dec_buf] + $02 = $2c             ; "00,OK"
      [dec_buf] + $03 = $4f
      [dec_buf] + $04 = $4b
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([devcode].w == $0000, "device code 0")

      [dec_buf] + $01 = $31             ; "01,..." DIRECTORY EMPTY
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "01 is advisory, not a failure")
      assert([devcode].w == 1, "and the code is still reported")

      [dec_buf] + $01 = $32             ; "02,..." REQUEST TRUNCATED
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "02 is advisory too")

      [dec_buf] = $32                   ; "21,UNKNOWN COMMAND"
      [dec_buf] + $01 = $31
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")

      [dec_buf] = $39                   ; "99,FUNCTION NOT IMPLEMENTED"
      [dec_buf] + $01 = $39
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")

      [dec_target] = $04                ; "81,INVALID PARAMS" on the control target
      [dec_buf] = $38
      [dec_buf] + $01 = $31
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")

      [dec_target] = $01                ; "85,NO FILE OPEN"
      [dec_buf] = $38
      [dec_buf] + $01 = $35
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
      assert([devcode].w == 85, "the raw code is kept")

      ; "03,MORE DATA NOT SUPPORTED" is a network failure, not an advisory.
      [dec_target] = $03
      [dec_buf] = $30
      [dec_buf] + $01 = $33
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
    }

    test("sdk-decode-decimal3", "NNN TEXT decoding, and what counts as an error") {
      [dec_target] = $06
      [dec_len] = $06
      [dec_buf] = $30                   ; "000 OK"
      [dec_buf] + $01 = $30
      [dec_buf] + $02 = $30
      [dec_buf] + $03 = $20
      [dec_buf] + $04 = $4f
      [dec_buf] + $05 = $4b
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([devcode].w == $0000, "device code 0")

      [dec_buf] = $32                   ; "200 OK"
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "2xx is success")
      assert([devcode].w == 200, "and the code is the server's")

      [dec_buf] = $34                   ; "404 ..."
      [dec_buf] + $01 = $30
      [dec_buf] + $02 = $34
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
      assert([devcode].w == 404, "404 kept verbatim: it may be the remote server's")

      [dec_buf] = $35                   ; "503 ..."
      [dec_buf] + $01 = $30
      [dec_buf] + $02 = $33
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
      assert([devcode].w == 503, "503")
    }

    ; **A successful HTTP exchange does not answer with a code.** Firmware 3.15
    ; puts the response line itself in the status - the whole header block - so
    ; the status begins "HTTP/1.x NNN Text". Before this was decoded, a 200 read
    ; as the binary form and came back as ULTIMATE_ERR_DEVICE: the SDK reported
    ; a failure for every request that worked. Measured on hardware; the shapes
    ; here are transcribed from what the wire really carried.
    test("sdk-decode-http-response-line", "a 200 is success, and the code is kept") {
      [dec_target] = $06
      [dec_len] = $0f
      [dec_buf] = $48                   ; "HTTP/1.0 200 OK"
      [dec_buf] + $01 = $54
      [dec_buf] + $02 = $54
      [dec_buf] + $03 = $50
      [dec_buf] + $04 = $2f
      [dec_buf] + $05 = $31
      [dec_buf] + $06 = $2e
      [dec_buf] + $07 = $30
      [dec_buf] + $08 = $20
      [dec_buf] + $09 = $32
      [dec_buf] + $0a = $30
      [dec_buf] + $0b = $30
      [dec_buf] + $0c = $20
      [dec_buf] + $0d = $4f
      [dec_buf] + $0e = $4b
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([devcode].w == $00c8, "device code 200")
    }

    ; The server's own failure, which is a device error with the number kept -
    ; the same rule the NNN form already followed.
    test("sdk-decode-http-404", "the remote server said no, and that is a device error") {
      [dec_target] = $06
      [dec_len] = $0d
      [dec_buf] = $48                   ; "HTTP/1.1 404 "
      [dec_buf] + $01 = $54
      [dec_buf] + $02 = $54
      [dec_buf] + $03 = $50
      [dec_buf] + $04 = $2f
      [dec_buf] + $05 = $31
      [dec_buf] + $06 = $2e
      [dec_buf] + $07 = $31
      [dec_buf] + $08 = $20
      [dec_buf] + $09 = $34
      [dec_buf] + $0a = $30
      [dec_buf] + $0b = $34
      [dec_buf] + $0c = $20
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
      assert([devcode].w == $0194, "device code 404")
    }

    ; 399 and 400 are the two sides of the line, and the boundary is worth
    ; pinning because it is the whole of the success rule.
    test("sdk-decode-http-boundary", "399 passes, 400 does not") {
      [dec_target] = $06
      [dec_len] = $0c
      [dec_buf] = $48
      [dec_buf] + $01 = $54
      [dec_buf] + $02 = $54
      [dec_buf] + $03 = $50
      [dec_buf] + $04 = $2f
      [dec_buf] + $05 = $31
      [dec_buf] + $06 = $2e
      [dec_buf] + $07 = $31
      [dec_buf] + $08 = $20
      [dec_buf] + $09 = $33            ; "399"
      [dec_buf] + $0a = $39
      [dec_buf] + $0b = $39
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "399 is success")
      assert([devcode].w == $018f, "device code 399")

      [dec_buf] + $09 = $34            ; "400"
      [dec_buf] + $0a = $30
      [dec_buf] + $0b = $30
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "400 is not")
      assert([devcode].w == $0190, "device code 400")
    }

    ; The firmware's own errors still arrive as three digits and must keep
    ; working: "400 BAD COMMAND" is what a bad handle answers, and it must not
    ; be mistaken for a response line just because it shares a number.
    test("sdk-decode-http-firmware-error", "the NNN form still decodes") {
      [dec_target] = $06
      [dec_len] = $04
      [dec_buf] = $34                   ; "400 "
      [dec_buf] + $01 = $30
      [dec_buf] + $02 = $30
      [dec_buf] + $03 = $20
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
      assert([devcode].w == $0190, "device code 400")
    }

    ; A truncated response line has no code to read, and inventing one would be
    ; worse than saying so.
    test("sdk-decode-http-truncated", "no digits after the space is malformed") {
      [dec_target] = $06
      [dec_len] = $09
      [dec_buf] = $48                   ; "HTTP/1.0 " and nothing after it
      [dec_buf] + $01 = $54
      [dec_buf] + $02 = $54
      [dec_buf] + $03 = $50
      [dec_buf] + $04 = $2f
      [dec_buf] + $05 = $31
      [dec_buf] + $06 = $2e
      [dec_buf] + $07 = $30
      [dec_buf] + $08 = $20
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $03, "ULTIMATE_ERR_PROTOCOL")
    }

    ; "HTTP" without the slash is not a response line, and must not be treated
    ; as one - it is the DOS case, words instead of a code.
    test("sdk-decode-http-prefix-is-exact", "five bytes, and all five matter") {
      [dec_target] = $01
      [dec_len] = $05
      [dec_buf] = $48                   ; "HTTPX"
      [dec_buf] + $01 = $54
      [dec_buf] + $02 = $54
      [dec_buf] + $03 = $50
      [dec_buf] + $04 = $58
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "read as words, which is a device error")
      assert([devcode].w == $ffff, "and carries no code")
    }

    test("sdk-decode-binary", "a single binary status byte from SoftwareIEC") {
      [dec_target] = $05
      [dec_len] = $01

      [dec_buf] = $00                   ; SOFTIEC_ST_OK
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")

      [dec_buf] = $01                   ; SOFTIEC_ST_FILE_NOT_FOUND
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")

      [dec_buf] = $05                   ; SOFTIEC_ST_MODULE_NOT_LOADED
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")

      [dec_buf] = $07                   ; SOFTIEC_ST_INVALID_NAME
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")

      [dec_buf] = $02                   ; SOFTIEC_ST_SAVE_ERROR
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $06, "ULTIMATE_ERR_IO")

      [dec_buf] = $80                   ; SOFTIEC_ST_VERIFY_ERROR
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
      assert([devcode].w == $0080, "the raw byte is kept")
    }

    ; The bug this exists to prevent: SOFTIEC_CMD_IDENTIFY answers with the
    ; firmware's shared ASCII status while every other command on that target
    ; answers in binary. A decoder that trusts the target id reads the '0' of
    ; "00,OK" as binary $30 and fails the one command documented as unable to
    ; fail - which made capability probing report a working target as absent.
    test("sdk-decode-by-shape", "status is decoded by shape, not by target id") {
      [dec_target] = $05                ; ASCII on the binary target
      [dec_len] = $05
      [dec_buf] = $30
      [dec_buf] + $01 = $30
      [dec_buf] + $02 = $2c
      [dec_buf] + $03 = $4f
      [dec_buf] + $04 = $4b
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([devcode].w == $0000, "read as decimal2, not as binary $30")

      [dec_len] = $01                   ; ...without swallowing a real binary one
      [dec_buf] = $05
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")

      [dec_target] = $01                ; three digits, arriving from DOS
      [dec_len] = $06
      [dec_buf] = $32
      [dec_buf] + $01 = $30
      [dec_buf] + $02 = $30
      [dec_buf] + $03 = $20
      [dec_buf] + $04 = $4f
      [dec_buf] + $05 = $4b
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the shape decides")
      assert([devcode].w == 200, "200")

      ; A binary status from a target with no binary vocabulary is a protocol
      ; violation, not an invitation to apply SoftwareIEC's numbering to it.
      [dec_len] = $01
      [dec_buf] = $05
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $03, "ULTIMATE_ERR_PROTOCOL")
      assert([devcode].w == $ffff, "UCI_DEVICE_CODE_NONE")

      [dec_target] = $03
      [dec_buf] = $00
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $03, "and the same from the network target")
    }

    test("sdk-decode-malformed", "what matches no encoding, and what only looks like it") {
      [dec_target] = $01

      [dec_len] = $00                   ; silence is success
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([devcode].w == $ffff, "UCI_DEVICE_CODE_NONE")

      [dec_len] = $01                   ; a lone digit matches no encoding, and
      [dec_buf] = $34                   ; DOS has no binary status to read it as
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $03, "ULTIMATE_ERR_PROTOCOL")

      [dec_len] = $02                   ; one digit and one letter: it claimed to
      [dec_buf] = $30                   ; be a code and then was not one
      [dec_buf] + $01 = $4b
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $03, "ULTIMATE_ERR_PROTOCOL")
    }

    ; Ultimate DOS answers every failure that came from the filesystem rather
    ; than from DOS itself with a bare FileSystem::get_error_string(res) - no
    ; "NN," in front of it - and only its own canned statuses carry a code. See
    ; software/filemanager/dos.cc: OPEN_FILE, WRITE_DATA, FILE_SEEK,
    ; DELETE_FILE, RENAME_FILE, COPY_FILE and CREATE_DIR all do it.
    ;
    ; This was found on the wire, not read out of the source: a WRITE_DATA to a
    ; full USB stick on firmware 3.15 answers "DISK IS FULL", and the SDK used
    ; to report that as ULTIMATE_ERR_PROTOCOL - telling a program the transport
    ; was broken when the disk was.
    test("sdk-decode-text-status", "words instead of a code are a device error") {
      [dec_target] = $01

      [dec_len] = $04                   ; "FULL", the shape of the real thing
      [dec_buf] = $46
      [dec_buf] + $01 = $55
      [dec_buf] + $02 = $4c
      [dec_buf] + $03 = $4c
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE, not a transport failure")
      assert([devcode].w == $ffff, "UCI_DEVICE_CODE_NONE: there is no code to keep")

      [dec_len] = $02                   ; "OK" - still no code, still the target
      [dec_buf] = $4f                   ; reporting rather than the wire failing
      [dec_buf] + $01 = $4b
      jsr([t_decode], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
    }

    ; These are the SDK's only strings meant for a screen rather than for the
    ; wire, and they are asserted byte for byte because "it goes through the
    ; charmap, so PETSCII is what you want" turned out to be half a rule.
    ;
    ; ca65's c64 charmap sends source 'A'-'Z' to PETSCII $C1-$DA. CHROUT turns
    ; those into screen codes $41-$5A, which are graphics symbols - so the error
    ; strings printed as glyphs on every real machine until a photograph of one
    ; showed it. Source 'a'-'z' becomes PETSCII $41-$5A and displays as letters,
    ; which is why the table is written in lowercase and why these assertions
    ; are on $4x and not $Cx.
    ;
    ; The other half of the rule stands unchanged: anything compared against the
    ; Ultimate is emitted numerically and never goes near the charmap.
    test("sdk-strerror", "every result code has a name, and an unknown one does too") {
      [err_code] = $00
      jsr([t_strerror], stop_on_rts = true, fail_on_brk = true)
      assert([err_text] == $4f, "'O' of OK: PETSCII $41-$5A, which CHROUT")
      assert(([err_text] + $01).b == $4b, "'K'. $C1-$DA would print as glyphs")
      assert(([err_text] + $02).b == $00, "terminated")

      [err_code] = $01
      jsr([t_strerror], stop_on_rts = true, fail_on_brk = true)
      assert([err_text] == $4e, "'N' of NO ULTIMATE FOUND")

      [err_code] = $02
      jsr([t_strerror], stop_on_rts = true, fail_on_brk = true)
      assert([err_text] == $54, "'T' of TIMEOUT")

      [err_code] = $c8
      jsr([t_strerror], stop_on_rts = true, fail_on_brk = true)
      assert([err_text] == $55, "'U' of UNKNOWN ERROR")
      assert(([err_text] + $01).b == $4e, "'N'")
    }

    ; --- the palette service ---
    ;
    ; The simulated Ultimate does not implement CTRL_CMD_GET_PALETTE and its
    ; three siblings: they are newer than firmware 3.15 and u64sim answers
    ; "21,UNKNOWN COMMAND". That is not a gap to apologise for, it is the case
    ; every program shipping to other people will meet on an older machine, and
    ; it is worth pinning here. What the palette actually does is proved on
    ; hardware, in tests/hardware/ucitest.c.
    ;
    ; [result] is set to $ff before each call so that an entry point which never
    ; ran cannot pass by leaving a zero behind.

    test("sdk-palette-unsupported", "a firmware without the palette commands says so") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)

      [result] = $ff
      jsr([t_palette_get], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED, not a hang and not OK")

      [result] = $ff
      jsr([t_palette_set], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")

      [result] = $ff
      [pal_index] = $00
      jsr([t_palette_color], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")

      [result] = $ff
      jsr([t_palette_reset], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")
    }

    ; The point of the previous test is only worth anything if the transport
    ; survives four rejections in a row, which is what a program probing for the
    ; palette on old firmware does before carrying on without it.
    test("sdk-palette-recovers", "the interface still works after the rejections") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      jsr([t_palette_reset], stop_on_rts = true, fail_on_brk = true)

      [result] = $ff
      [ident_target] = $01
      [ident_buflen] = $18
      [ident_buflen] + $01 = $00
      jsr([t_identify], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK from the next command")
      assert([reply0] == $55, "'U' of ULTIMATE - a real reply, not leftovers")
    }

    ; Argument checks happen before anything reaches the wire, so these are the
    ; part of the palette service the simulator can prove completely.
    test("sdk-palette-rejects-null", "a null buffer is refused, not read from page zero") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)

      [result] = $ff
      jsr([t_palette_get_null], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")

      [result] = $ff
      jsr([t_palette_set_null], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
    }

    test("sdk-palette-rejects-bad-index", "colour 16 does not exist, and never reaches the wire") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)

      [result] = $ff
      [pal_index] = $10
      jsr([t_palette_color], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")

      [result] = $ff
      [pal_index] = $ff
      jsr([t_palette_color], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")

      ; ...and the last valid one is still accepted, so the bound is off-by-one
      ; proof rather than "everything is rejected".
      [result] = $ff
      [pal_index] = $0f
      jsr([t_palette_color], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "reached the firmware: ULTIMATE_ERR_NOT_SUPPORTED")
    }

    ; --- turbo ---
    ;
    ; The SDK's only entry points that touch a hardware register directly.
    ;
    ; $D031 under sim6502 is ordinary read/write memory rather than a VIC that
    ; returns $FF for its unimplemented registers, and that is what makes these
    ; tests worth having: the register can be put into any state and the bit
    ; arithmetic checked exactly. Speed and badlines share one byte, so the way
    ; this goes wrong is one of them quietly clobbering the other, which no
    ; hardware test would notice and every demo would.
    ;
    ; What cannot be proved here is that the machine actually runs faster. That
    ; is tests/hardware/ucitest.c, timing a loop against the raster on a real
    ; Ultimate 64 with "Turbo Control" switched on.

    test("sdk-turbo-absent", "no turbo is reported as no turbo, not as speed $ff") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      $d031 = $ff                       ; what a machine with turbo off reads

      [result] = $ff
      jsr([t_turbo_available], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "not available")

      [result] = $00
      jsr([t_turbo_get], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $ff, "U64_TURBO_UNAVAILABLE, which is not a speed index")

      [result] = $00
      [turbo_arg] = $03
      jsr([t_turbo_set], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")
      assert($d031 == $ff, "and nothing was written")

      [result] = $00
      [turbo_arg] = $00
      jsr([t_turbo_badlines], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")
      assert($d031 == $ff, "and nothing was written")
    }

    test("sdk-turbo-reads-the-index", "the speed index is the low four bits") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)

      $d031 = $03
      [result] = $ff
      jsr([t_turbo_available], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $01, "available")

      [result] = $ff
      jsr([t_turbo_get], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $03, "U64_SPEED_4MHZ")

      ; ...and the badline bit is not part of the speed.
      $d031 = $83
      [result] = $ff
      jsr([t_turbo_get], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $03, "still 3, with badlines off")
    }

    ; The two halves of the register belong to different callers. Setting one
    ; must leave the other exactly as it was, in both directions.
    test("sdk-turbo-set-keeps-badlines", "changing speed does not touch bit 7") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)

      $d031 = $83                       ; 4MHz, badlines already off
      [turbo_arg] = $06
      jsr([t_turbo_set], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert($d031 == $86, "speed 6, and badlines still off")

      $d031 = $03                       ; 4MHz, badlines on
      [turbo_arg] = $06
      jsr([t_turbo_set], stop_on_rts = true, fail_on_brk = true)
      assert($d031 == $06, "speed 6, and badlines still on")
    }

    test("sdk-turbo-badlines-keeps-speed", "changing bit 7 does not touch the speed") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)

      $d031 = $06                       ; badlines on
      [turbo_arg] = $00                 ; ask for no badlines
      jsr([t_turbo_badlines], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert($d031 == $86, "bit 7 set, speed untouched")

      [turbo_arg] = $01                 ; and back
      jsr([t_turbo_badlines], stop_on_rts = true, fail_on_brk = true)
      assert($d031 == $06, "bit 7 clear, speed still 6")
    }

    ; $10 is the first index that does not exist; $0f is the last that does, so
    ; this proves a bound rather than a blanket refusal - and proves the check
    ; happens before the register is written, not after.
    test("sdk-turbo-rejects-bad-index", "index 16 is refused, and never written") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      $d031 = $05

      [result] = $00
      [turbo_arg] = $10
      jsr([t_turbo_set], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
      assert($d031 == $05, "the register was left alone")

      [result] = $00
      [turbo_arg] = $ff
      jsr([t_turbo_set], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
      assert($d031 == $05, "the register was left alone")

      [result] = $ff
      [turbo_arg] = $0f
      jsr([t_turbo_set], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the last real index is accepted")
      assert($d031 == $0f, "and written")
    }

    ; --- the DOS service ---
    ;
    ; u64sim implements the read-only half of Ultimate DOS against a real
    ; directory tree, tests/emulator/fixtures/usb0, so these run the commands
    ; for real rather than proving a rejection is reported cleanly. The tree
    ; holds one directory, `data`, and one file, `big.bin`.

    test("sdk-getpath", "the current directory comes back as a string") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [result] = $ff
      jsr([t_getpath], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([reply0] == $2f, "'/' - a path, and an absolute one")
    }

    ; The whole reason uci_exec_first and uci_exec_next exist. READ_DIR answers
    ; with one reply block per entry, <attrib> <name> with no terminator and no
    ; length, so the block boundary is the only separator there is. Draining the
    ; chain into one buffer - which is what uci_exec does and what every other
    ; command wants - would hand back "\x10data\x20big.bin" with nothing to say
    ; where the first name ended.
    test("sdk-readdir", "one entry per call, name and attributes separated") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [result] = $ff
      jsr([t_opendir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "OPEN_DIR succeeded")

      [result] = $ff
      [dir_attrib] = $00
      jsr([t_readdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "an entry")
      assert([dir_attrib] == $10, "DOS_ATTR_DIR: it is the `data` directory")
      assert([reply0] == $64, "'d' - the attribute byte is gone from the name")
      assert([reply1] == $61, "'a'")
      assert([reply2] == $74, "'t'")
      assert([reply3] == $61, "'a'")
      assert(([reply0] + $04).b == $00, "and the name is terminated")

      [result] = $ff
      jsr([t_readdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the second entry")
      assert([reply0] == $62, "'b' of big.bin")
      assert(([reply0] + $03).b == $2e, "'.' - the whole name, not a prefix")
      assert(([reply0] + $07).b == $00, "terminated after seven characters")

      ; The directory has two entries, so the third call is the end - and the
      ; end has a code of its own, so a caller never confuses it with a failure.
      [result] = $ff
      jsr([t_readdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $0a, "ULTIMATE_END")
    }

    ; **A walk that is abandoned has to be aborted**, and until this was tested
    ; the abort did not work either. The firmware holds a reply block until it
    ; is released, and it does not service an abort while it is holding one -
    ; so a program that read one entry and gave up left every later command
    ; timing out, including the abort that was supposed to rescue it.
    ;
    ; uci_abort releases the block first now. This is the test that says so:
    ; one entry, then straight into another command, which has to work.
    test("sdk-abort-recovers-an-abandoned-walk", "giving up half way is a thing programs do") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      jsr([t_opendir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the walk started")
      jsr([t_readdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "one entry, and then we lose interest")

      [result] = $ff
      jsr([t_abort], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the abort itself succeeds, which it did not before")

      [result] = $ff
      jsr([t_getpath], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and the interface takes commands again")

      [result] = $ff
      jsr([t_getpath], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "...more than one of them")
    }

    test("sdk-readdir-without-opendir", "a walk that was never started is over") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [result] = $ff
      jsr([t_readdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $0a, "ULTIMATE_END, not a device error")
    }

    ; chdir, then getpath, so the second command proves the first did something
    ; rather than merely returning OK.
    test("sdk-chdir", "changing directory moves the current path") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $64            ; "data", in ASCII: the wire's character set
      [reply1] = $61
      [reply2] = $74
      [reply3] = $61
      [reply0] + $04 = $00
      [result] = $ff
      jsr([t_chdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "CHANGE_DIR succeeded")

      [result] = $ff
      jsr([t_getpath], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and the path came back")
      ; The fixture tree is mounted at /Usb0, so the path is /Usb0/data - which
      ; is worth asserting in full rather than guessing at a prefix.
      assert([reply0] == $2f, "'/'")
      assert(([reply0] + $06).b == $64, "'d'")
      assert(([reply0] + $07).b == $61, "'a'")
      assert(([reply0] + $08).b == $74, "'t'")
      assert(([reply0] + $09).b == $61, "'a'")
    }

    ; Open, read, close. big.bin is the fixture with known contents, and the
    ; read goes through DOS_CMD_READ_DATA's 512-byte block chain, which uci_exec
    ; walks - so this is also the test that the chain still stitches now that
    ; the collect loop has been split.
    test("sdk-open-read-close", "a file opens, reads and closes") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      ; Back to the root first: the test above moved the current directory, and
      ; a test that only passes in the order it happens to sit in is not a test.
      [reply0] = $2f            ; "/Usb0"
      [reply1] = $55
      [reply2] = $73
      [reply3] = $62
      [reply0] + $04 = $30
      [reply0] + $05 = $00
      jsr([t_chdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "back at the root")

      [reply0] = $62            ; "big.bin"
      [reply1] = $69
      [reply2] = $67
      [reply3] = $2e
      [reply0] + $04 = $62
      [reply0] + $05 = $69
      [reply0] + $06 = $6e
      [reply0] + $07 = $00
      [result] = $ff
      jsr([t_open], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "OPEN_FILE succeeded")

      [reply_len] = $ff
      [reply_len] + $01 = $ff
      [result] = $ff
      jsr([t_read], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "READ_DATA succeeded")
      assert([reply_len] == $40, "64 bytes, which is what was asked for")
      assert(([reply_len] + $01).b == $00, "...and no more")

      [result] = $ff
      jsr([t_close], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "CLOSE_FILE succeeded")
    }

    ; A file that is not there. The firmware answers "FILE DOESN'T EXIST" - bare
    ; text, no "NN," code, which is what every filesystem-level DOS failure looks
    ; like - so this is the SDK end of the assertion in protocol.suite.
    test("sdk-open-missing-file", "a missing file is a device error, not a protocol one") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $6e            ; "nosuch.xyz"
      [reply1] = $6f
      [reply2] = $73
      [reply3] = $75
      [reply0] + $04 = $63
      [reply0] + $05 = $68
      [reply0] + $06 = $2e
      [reply0] + $07 = $78
      [reply0] + $08 = $79
      [reply0] + $09 = $7a
      [reply0] + $0a = $00
      [result] = $ff
      jsr([t_open], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE")
    }

    ; --- load ---
    ;
    ; There is no SoftwareIEC target under the simulator, so ultimate_load's
    ; fast path fails here every time and the DOS fallback runs. That is the
    ; half worth testing in CI: it is what every machine without an IEC drive
    ; falls back to, and it is the half a hardware test stops reaching the
    ; moment the fast path works. LOAD_SU/LOAD_EX are proved in
    ; tests/hardware/ucitest.c instead.
    ;
    ; big.bin is 600 bytes, and buf_data is 1024, so both fit with room to spare.

    test("sdk-bload-honours-its-limit", "raw bytes, and no more than asked for") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $2f            ; chdir "/Usb0", so the name below resolves
      [reply1] = $55
      [reply2] = $73
      [reply3] = $62
      [reply0] + $04 = $30
      [reply0] + $05 = $00
      jsr([t_chdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "at the root")

      [reply0] = $62            ; "big.bin"
      [reply1] = $69
      [reply2] = $67
      [reply3] = $2e
      [reply0] + $04 = $62
      [reply0] + $05 = $69
      [reply0] + $06 = $6e
      [reply0] + $07 = $00
      [load_addr] = [buf_data].l
      [load_addr] + $01 = [buf_data].h
      [load_max] = $40
      [load_max] + $01 = $00
      [result] = $ff
      jsr([t_bload], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")

      ; 64 bytes asked for, 64 written, and the end address says so - which is
      ; the assertion that fails if the limit is ignored on a 600-byte file.
      assert([load_end].w == [buf_data] + $0040, "stopped exactly at the limit")

      ; big.bin counts up from zero, so the first bytes say whether anything was
      ; skipped. bload strips nothing, which is the whole difference from load.
      assert([buf_data] == $00, "byte 0 of the file, not of its body")
      assert(([buf_data] + $01).b == $01, "then 1")
      assert(([buf_data] + $02).b == $02, "then 2")
    }

    ; A PRG load with an address given: the two header bytes are consumed and
    ; never stored, so 600 bytes of file put 598 in memory.
    test("sdk-load-strips-the-header", "load is not bload with extra steps") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $62            ; "big.bin"
      [reply1] = $69
      [reply2] = $67
      [reply3] = $2e
      [reply0] + $04 = $62
      [reply0] + $05 = $69
      [reply0] + $06 = $6e
      [reply0] + $07 = $00
      [load_addr] = [buf_data].l
      [load_addr] + $01 = [buf_data].h
      [load_max] = $00
      [load_max] + $01 = $00
      [result] = $ff
      jsr([t_load], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK, after the fast path was tried and failed")
      assert([load_end].w == [buf_data] + $0256, "598 bytes: 600 less the header")

      ; The same counting file, two bytes further in: $00 $01 were the header
      ; and were consumed, so the first byte stored is $02.
      assert([buf_data] == $02, "the header is gone, not merely skipped over")
      assert(([buf_data] + $01).b == $03, "then 3")
    }

    ; --- the write half ---
    ;
    ; Everything above reads. These write, and they write into the fixture tree
    ; itself, so they follow the test data policy in docs/handover.md section 6
    ; to the letter: the file is created here, used here, and deleted here.
    ;
    ; It goes in `data`, not in the root: the readdir test asserts the root has
    ; exactly two entries and then ends, so a scratch file left behind by a run
    ; that died halfway would fail a test that has nothing to do with writing.

    test("sdk-write-seek-read", "a file is created, written, and read back from an offset") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $2f            ; "/Usb0/data"
      [reply1] = $55
      [reply2] = $73
      [reply3] = $62
      [reply0] + $04 = $30
      [reply0] + $05 = $2f
      [reply0] + $06 = $64
      [reply0] + $07 = $61
      [reply0] + $08 = $74
      [reply0] + $09 = $61
      [reply0] + $0a = $00
      [result] = $ff
      jsr([t_chdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "in the fixture's subdirectory")

      ; "wr.tmp", and four bytes to put in it.
      [reply0] = $77
      [reply1] = $72
      [reply2] = $2e
      [reply3] = $74
      [reply0] + $04 = $6d
      [reply0] + $05 = $70
      [reply0] + $06 = $00

      [buf_data] = $41
      [buf_data] + $01 = $42
      [buf_data] + $02 = $43
      [buf_data] + $03 = $44
      [wr_len] = $04
      [wr_len] + $01 = $00

      [result] = $ff
      jsr([t_create], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "OPEN_FILE created it")

      [result] = $ff
      jsr([t_write], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "WRITE_DATA succeeded")

      [result] = $ff
      jsr([t_close], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and it closed")

      ; Reopen for reading. The name is still in `reply` - t_create did not
      ; disturb it - and t_open asks for DOS_FA_READ.
      [result] = $ff
      jsr([t_open], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the file that was just written opens")

      ; Two bytes in, so a read that ignored the seek would answer $41 and four
      ; bytes rather than $43 and two.
      [seek_pos] = $02
      [seek_pos] + $01 = $00
      [seek_pos] + $02 = $00
      [seek_pos] + $03 = $00
      [result] = $ff
      jsr([t_seek], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "FILE_SEEK succeeded")

      [reply_len] = $ff
      [reply_len] + $01 = $ff
      [result] = $ff
      jsr([t_read], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "READ_DATA succeeded")
      assert([reply_len] == $02, "two bytes left after the seek")
      assert(([reply_len] + $01).b == $00, "and no more: short is the end of the file")
      assert([reply0] == $43, "'C' - the third byte written, so the seek landed")
      assert([reply1] == $44, "'D'")

      [result] = $ff
      jsr([t_close], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "closed again")

      ; t_read overwrote `reply` with the file's own bytes, so the name goes
      ; back before the delete asks for it.
      [reply0] = $77            ; "wr.tmp"
      [reply1] = $72
      [reply2] = $2e
      [reply3] = $74
      [reply0] + $04 = $6d
      [reply0] + $05 = $70
      [reply0] + $06 = $00
      [result] = $ff
      jsr([t_delete], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "DELETE_FILE succeeded")

      ; And it is really gone, which is what makes the cleanup a test rather
      ; than a hope.
      [result] = $00
      jsr([t_open], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "opening it again is a device error: the file is gone")
    }

    ; save is the same three arguments as bload, in the other direction: a
    ; region of memory becomes a file. It writes through DOS open/write/close,
    ; so this is also the second caller of the write path.
    test("sdk-save-round-trips", "what save wrote is what bload reads back") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $2f            ; "/Usb0/data"
      [reply1] = $55
      [reply2] = $73
      [reply3] = $62
      [reply0] + $04 = $30
      [reply0] + $05 = $2f
      [reply0] + $06 = $64
      [reply0] + $07 = $61
      [reply0] + $08 = $74
      [reply0] + $09 = $61
      [reply0] + $0a = $00
      jsr([t_chdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "in the fixture's subdirectory")

      [reply0] = $73            ; "sv.tmp"
      [reply1] = $76
      [reply2] = $2e
      [reply3] = $74
      [reply0] + $04 = $6d
      [reply0] + $05 = $70
      [reply0] + $06 = $00

      [buf_data] = $de
      [buf_data] + $01 = $ad
      [buf_data] + $02 = $be
      [buf_data] + $03 = $ef
      [load_addr] = [buf_data].l
      [load_addr] + $01 = [buf_data].h
      [load_max] = $04
      [load_max] + $01 = $00
      [result] = $ff
      jsr([t_save], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the region became a file")

      ; Read it back over the top of itself after wiping it, so the assertion
      ; cannot pass on the bytes that were already there.
      [buf_data] = $00
      [buf_data] + $01 = $00
      [buf_data] + $02 = $00
      [buf_data] + $03 = $00
      [load_max] = $04
      [load_max] + $01 = $00
      [result] = $ff
      jsr([t_bload], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and it reads back")
      assert([load_end].w == [buf_data] + $0004, "four bytes, the four that were saved")
      assert([buf_data] == $de, "byte for byte")
      assert(([buf_data] + $01).b == $ad, "still")
      assert(([buf_data] + $02).b == $be, "and")
      assert(([buf_data] + $03).b == $ef, "again")

      [reply0] = $73            ; "sv.tmp", back over what bload did not touch
      [reply1] = $76
      [reply2] = $2e
      [reply3] = $74
      [reply0] + $04 = $6d
      [reply0] + $05 = $70
      [reply0] + $06 = $00
      [result] = $ff
      jsr([t_delete], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and the fixture tree is as it was found")
    }

    ; --- the RAM expansion ---
    ;
    ; $DF00-$DF0A under sim6502 is ordinary read/write memory rather than a REU,
    ; which is exactly what makes these worth having: the registers can be read
    ; back byte for byte after a transfer was asked for, and the done bit can be
    ; put into either state to check both answers. What cannot be proved here is
    ; that a byte moved - tests/hardware/ucitest.c stashes and fetches on a real
    ; Ultimate with the expansion switched on.
    ;
    ; The probe reads back what it wrote, so plain RAM looks like a REU to it.
    ; That is stated in reu.s and it is why these tests can run at all.

    test("sdk-reu-programs-every-register", "the address and length reach the right bytes") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)

      $df00 = $40               ; REU_STAT_DONE: a transfer that finished
      [load_addr] = $34         ; the C64 end: $1234
      [load_addr] + $01 = $12
      [reu_at] = $45            ; and the REU end: $012345
      [reu_at] + $01 = $23
      [reu_at] + $02 = $01
      [reu_at] + $03 = $00
      [reu_len] = $00           ; 256 bytes
      [reu_len] + $01 = $01
      [reu_len] + $02 = $00
      [reu_len] + $03 = $00

      [result] = $ff
      jsr([t_reu_stash], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")

      assert($df02 == $34, "C64 address low")
      assert($df03 == $12, "C64 address high")
      assert($df04 == $45, "REU address low")
      assert($df05 == $23, "REU address middle")
      assert($df06 == $01, "REU address high - the 24-bit one, not truncated")
      assert($df07 == $00, "length low")
      assert($df08 == $01, "length high")
      assert($df01 == $90, "EXECUTE and NOW, with mode 00: C64 to REU")
    }

    test("sdk-reu-fetch-is-the-other-direction", "one bit apart, and it is the right bit") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)

      $df00 = $40
      [load_addr] = $00
      [load_addr] + $01 = $c0
      [reu_at] = $00
      [reu_at] + $01 = $00
      [reu_at] + $02 = $00
      [reu_at] + $03 = $00
      [reu_len] = $00           ; 0 is 65536 bytes, which is the REU's own
      [reu_len] + $01 = $00     ; convention and not an SDK invention
      [reu_len] + $02 = $00
      [reu_len] + $03 = $00

      [result] = $ff
      jsr([t_reu_fetch], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert($df01 == $91, "mode 01: REU to C64")
      assert($df07 == $00, "and a length of zero went out as zero")
      assert($df08 == $00, "...both halves of it")
    }

    ; The done bit is the only evidence a transfer happened, and it is cleared by
    ; reading it - so a caller that gets ULTIMATE_OK has been told by the
    ; hardware, not by the SDK's optimism.
    test("sdk-reu-notices-nothing-happened", "no done bit is a failure, not a success") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)

      $df00 = $00
      [load_addr] = $00
      [load_addr] + $01 = $c0
      [reu_at] = $00
      [reu_at] + $01 = $00
      [reu_at] + $02 = $00
      [reu_at] + $03 = $00
      [reu_len] = $10
      [reu_len] + $01 = $00
      [reu_len] + $02 = $00
      [reu_len] + $03 = $00

      [result] = $ff
      jsr([t_reu_stash], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $06, "ULTIMATE_ERR_IO")
    }

    ; The other half of the service, and the half that does go through
    ; uci_exec: DOS_CMD_LOAD_REU moves the open file into the expansion without
    ; any of it passing through the C64. There is no filename in the command -
    ; it works on whatever is open, exactly as READ_DATA does.
    ;
    ; **u64sim does not implement it**, and answers "21,UNKNOWN COMMAND". That
    ; is pinned here rather than skipped, for the same reason the palette
    ; commands are: it is the case an older firmware presents, and a caller has
    ; to get ULTIMATE_ERR_NOT_SUPPORTED out of it rather than a hang or a lie.
    ; The command really running is tests/hardware/ucitest.c, where firmware
    ; 3.15 answers "00,OK" and a sentence saying how many bytes it moved.
    test("sdk-reu-load-takes-the-open-file", "an unimplemented REU load is reported, not guessed at") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $2f            ; chdir "/Usb0"
      [reply1] = $55
      [reply2] = $73
      [reply3] = $62
      [reply0] + $04 = $30
      [reply0] + $05 = $00
      jsr([t_chdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "at the root")

      [reply0] = $62            ; "big.bin"
      [reply1] = $69
      [reply2] = $67
      [reply3] = $2e
      [reply0] + $04 = $62
      [reply0] + $05 = $69
      [reply0] + $06 = $6e
      [reply0] + $07 = $00
      [result] = $ff
      jsr([t_open], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the file is open")

      [reu_at] = $00
      [reu_at] + $01 = $00
      [reu_at] + $02 = $00
      [reu_at] + $03 = $00
      [reu_len] = $58           ; 600 bytes, the whole of big.bin
      [reu_len] + $01 = $02
      [reu_len] + $02 = $00
      [reu_len] + $03 = $00
      [timeout_val] = $2f
      jsr([t_set_timeout], stop_on_rts = true, fail_on_brk = true)
      [result] = $ff
      jsr([t_reu_load], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED, from this firmware")
      jsr([t_get_timeout], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $2f, "the caller's timeout budget is restored")

      [result] = $ff
      jsr([t_close], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and the file closed")
    }

    ; --- byte results set the flags ---
    ;
    ; docs/asm-abi.md promises that a byte result in A leaves Z set from A, so
    ; `jsr` / `beq` tests the result. Every entry used to end in `ldx #$00`,
    ; which left Z set whatever A was. $02 is the Z bit of the status byte the
    ; harness stores.

    test("sdk-flags-ok-sets-z", "ultimate_init returning ULTIMATE_OK leaves Z set") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      [result] = $ff
      jsr([t_flags_init], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $02, "Z set: the result is zero")
    }

    test("sdk-flags-one-clears-z", "ultimate_reu_available returning 1 leaves Z clear") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      $df00 = $40               ; REU_STAT_DONE, so the probe sees an expansion
      [result] = $ff
      jsr([t_flags_reu_avail], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "Z clear: the result is 1")
    }

    test("sdk-flags-zero-byte-sets-z", "ultimate_audio_available returning 0 before init leaves Z set") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      [result] = $ff
      jsr([t_flags_audio_avail], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $02, "Z set: the result is zero")
    }

    ; --- what a file is, and moving files about ---
    ;
    ; stat's reply is a twelve-byte header and then the name with no
    ; terminator, so these assert on the size field and on the name landing
    ; where DOS_INFO_NAME says it does. big.bin is 600 bytes, which is $0258 -
    ; a number with a non-zero high byte, so a decoder that read only the low
    ; one would pass the first assertion and fail the second.

    test("sdk-stat-reports-the-size", "a file's size, without opening it") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $2f            ; "/Usb0"
      [reply1] = $55
      [reply2] = $73
      [reply3] = $62
      [reply0] + $04 = $30
      [reply0] + $05 = $00
      jsr([t_chdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "at the root")

      [reply0] = $62            ; "big.bin"
      [reply1] = $69
      [reply2] = $67
      [reply3] = $2e
      [reply0] + $04 = $62
      [reply0] + $05 = $69
      [reply0] + $06 = $6e
      [reply0] + $07 = $00
      [result] = $ff
      jsr([t_stat], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "FILE_STAT succeeded")
      assert([finfo] == $58, "600 bytes, low")
      assert(([finfo] + $01).b == $02, "600 bytes, high - not a byte-wide read")
      assert(([finfo] + $02).b == $00, "and nothing above it")
      assert(([finfo] + $03).b == $00, "...")
      assert(([finfo] + $0c).b == $62, "'b' of big.bin, at DOS_INFO_NAME")
      assert(([finfo] + $0d).b == $69, "'i'")
      assert(([finfo] + $13).b == $00, "and the SDK's terminator after it")
    }

    test("sdk-stat-missing-file", "a file that is not there is a device error") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)

      [reply0] = $6e            ; "nope.xyz"
      [reply1] = $6f
      [reply2] = $70
      [reply3] = $65
      [reply0] + $04 = $2e
      [reply0] + $05 = $78
      [reply0] + $06 = $79
      [reply0] + $07 = $7a
      [reply0] + $08 = $00
      [result] = $00
      jsr([t_stat], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "ULTIMATE_ERR_DEVICE, not a protocol error")
    }

    test("sdk-fstat-describes-the-open-file", "the same, for the file already open") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $2f            ; "/Usb0"
      [reply1] = $55
      [reply2] = $73
      [reply3] = $62
      [reply0] + $04 = $30
      [reply0] + $05 = $00
      jsr([t_chdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "at the root")

      [reply0] = $62            ; "big.bin"
      [reply1] = $69
      [reply2] = $67
      [reply3] = $2e
      [reply0] + $04 = $62
      [reply0] + $05 = $69
      [reply0] + $06 = $6e
      [reply0] + $07 = $00
      [result] = $ff
      jsr([t_open], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the file is open")

      [finfo] = $ff
      [finfo] + $01 = $ff
      [result] = $ff
      jsr([t_fstat], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "FILE_INFO succeeded")
      assert([finfo] == $58, "600 bytes, low")
      assert(([finfo] + $01).b == $02, "600 bytes, high")

      [result] = $ff
      jsr([t_close], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and it closed")
    }

    ; --- copy, rename, and make directory ---
    ;
    ; These write, so they follow the same rule the write tests above do: what
    ; is created here is deleted here, in the fixture's own subdirectory.
    ;
    ; The copy and the rename are what prove the <name> $00 <name> shape
    ; reaches the firmware intact - the first name is sent with its own
    ; terminator counted in the argument length, and getting that wrong makes
    ; the firmware read the two names as one.

    test("sdk-copy-and-rename", "a file is copied, renamed, and taken away again") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $2f            ; "/Usb0/data"
      [reply1] = $55
      [reply2] = $73
      [reply3] = $62
      [reply0] + $04 = $30
      [reply0] + $05 = $2f
      [reply0] + $06 = $64
      [reply0] + $07 = $61
      [reply0] + $08 = $74
      [reply0] + $09 = $61
      [reply0] + $0a = $00
      [result] = $ff
      jsr([t_chdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "in the fixture's subdirectory")

      ; "cp1.tmp", with four bytes in it.
      [reply0] = $63
      [reply1] = $70
      [reply2] = $31
      [reply3] = $2e
      [reply0] + $04 = $74
      [reply0] + $05 = $6d
      [reply0] + $06 = $70
      [reply0] + $07 = $00
      [buf_data] = $41
      [buf_data] + $01 = $42
      [buf_data] + $02 = $43
      [buf_data] + $03 = $44
      [wr_len] = $04
      [wr_len] + $01 = $00
      [result] = $ff
      jsr([t_create], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the source file was created")
      [result] = $ff
      jsr([t_write], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and written")
      [result] = $ff
      jsr([t_close], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and closed")

      ; "cp2.tmp" as the destination.
      [name2] = $63
      [name2] + $01 = $70
      [name2] + $02 = $32
      [name2] + $03 = $2e
      [name2] + $04 = $74
      [name2] + $05 = $6d
      [name2] + $06 = $70
      [name2] + $07 = $00
      [result] = $ff
      jsr([t_copy], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "COPY_FILE succeeded")

      ; The copy has the source's four bytes, which is what says the second
      ; name was read as a name and not as part of the first.
      [reply0] = $63            ; "cp2.tmp"
      [reply1] = $70
      [reply2] = $32
      [reply3] = $2e
      [reply0] + $04 = $74
      [reply0] + $05 = $6d
      [reply0] + $06 = $70
      [reply0] + $07 = $00
      [result] = $ff
      jsr([t_stat], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the copy is there")
      assert([finfo] == $04, "with the four bytes the source had")

      ; Rename it to "cp3.tmp", and stat that instead.
      [name2] + $02 = $33
      [result] = $ff
      jsr([t_rename], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "RENAME_FILE succeeded")

      [reply2] = $33            ; "cp3.tmp"
      [result] = $ff
      jsr([t_stat], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the new name is there")
      assert([finfo] == $04, "still four bytes")

      [reply2] = $32            ; and the old one is not
      [result] = $00
      jsr([t_stat], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $07, "the old name is gone")

      ; Clean up: the copy under its new name, and the source.
      [reply2] = $33
      [result] = $ff
      jsr([t_delete], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "the copy was deleted")
      [reply2] = $31
      [result] = $ff
      jsr([t_delete], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and so was the source")
    }

    ; --- the services this firmware does not have ---
    ;
    ; The simulated Ultimate implements the Ultimate DOS file commands and
    ; nothing else, so the disk, clock, machine, network and HTTP services all
    ; answer here the way they answer on firmware too old to have them: the DOS
    ; target says "99,FUNCTION NOT IMPLEMENTED" and the control target says
    ; "21,UNKNOWN COMMAND", and the SDK turns both into
    ; ULTIMATE_ERR_NOT_SUPPORTED.
    ;
    ; That is the case a program has to handle - call one and look at the
    ; result - so it is pinned here, the same way the palette commands are.
    ; What each command does on firmware that has it is covered by
    ; tests/hardware.

    test("sdk-home-on-firmware-without-it", "the home directory is optional") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [result] = $ff
      jsr([t_home], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ULTIMATE_ERR_NOT_SUPPORTED")
    }

    test("sdk-mount-unmount-swap", "the disk image commands, on firmware without them") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)

      [reply0] = $61            ; "a.d64"
      [reply1] = $2e
      [reply2] = $64
      [reply3] = $36
      [reply0] + $04 = $34
      [reply0] + $05 = $00
      [drive_arg] = $08         ; the drive answering as device 8
      [result] = $ff
      jsr([t_mount], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "MOUNT_DISK: ULTIMATE_ERR_NOT_SUPPORTED")

      [result] = $ff
      jsr([t_unmount], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "UMOUNT_DISK: ULTIMATE_ERR_NOT_SUPPORTED")

      [result] = $ff
      jsr([t_swap], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "SWAP_DISK: ULTIMATE_ERR_NOT_SUPPORTED")
    }

    test("sdk-mount-without-a-name", "an image with no name never reaches the wire") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [reply0] = $00
      [drive_arg] = $08
      [result] = $ff
      jsr([t_mount], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
    }

    test("sdk-clock", "reading and setting the clock, on firmware without one") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $18      ; ULTIMATE_TIME_BUFFER
      [ident_buflen] + $01 = $00
      [flag_arg] = $00          ; ULTIMATE_TIME_PLAIN
      [result] = $ff
      jsr([t_get_time], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "GET_TIME: ULTIMATE_ERR_NOT_SUPPORTED")

      ; 126 is 2026: the year byte is the year less 1900.
      [time_arg] = $7e
      [time_arg] + $01 = $08
      [time_arg] + $02 = $16
      [time_arg] + $03 = $0e
      [time_arg] + $04 = $1e
      [time_arg] + $05 = $00
      [result] = $ff
      jsr([t_set_time], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "SET_TIME: ULTIMATE_ERR_NOT_SUPPORTED")
    }

    test("sdk-machine-control", "reset and freeze reach the control target") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)

      ; Reset is fire-and-forget, so it succeeds as soon as the interface is
      ; idle again whether or not the target did anything with it. On a real
      ; machine nothing after the call runs.
      [result] = $ff
      jsr([t_reboot], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "REBOOT: ULTIMATE_OK, and no data phase")

      [result] = $ff
      jsr([t_freeze], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "FREEZE: ULTIMATE_ERR_NOT_SUPPORTED")
    }

    test("sdk-drives", "the emulated drives, on firmware without the commands") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)

      [drive_arg] = $00         ; ULTIMATE_DRIVE_A
      [flag_arg] = $01
      [result] = $ff
      jsr([t_drive_enable], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "ENABLE_DRIVE_A: ULTIMATE_ERR_NOT_SUPPORTED")

      [flag_arg] = $ff
      [result] = $ff
      jsr([t_drive_power], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "DRIVE_A_POWER: ULTIMATE_ERR_NOT_SUPPORTED")
      assert([flag_arg] == $00, "and it reports the drive as off, not as unknown")

      [reply0] = $ff
      [result] = $ff
      jsr([t_drive_info], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "GET_DRVINFO: ULTIMATE_ERR_NOT_SUPPORTED")
      assert([reply0] == $00, "and the count is cleared, so no records are read")

      [result] = $ff
      jsr([t_ramdisk_info], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "GET_RAMDISKINFO: ULTIMATE_ERR_NOT_SUPPORTED")
    }

    test("sdk-drives-reject-a-third-drive", "there are two, and the third never reaches the wire") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [drive_arg] = $02
      [flag_arg] = $01
      [result] = $ff
      jsr([t_drive_enable], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
      [result] = $ff
      jsr([t_drive_power], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
    }

    ; docs/uci.md, "Drive information": control_target.cc adds three to the
    ; reply length for each of drives A and B, and IecInterface::info then
    ; increments the same count byte once per occupied IEC bus slot without
    ; growing the length. A machine with SoftwareIEC enabled therefore declares
    ; more records than it sends, and a parser that insisted the two agreed
    ; would fail on every such machine.
    ;
    ; u64sim does not implement GET_DRVINFO, so these call the SDK's own reply
    ; parser with the replies a real machine sends. It is the shipping routine,
    ; not a copy of it, so changing the parser changes what is asserted here.
    test("sdk-drvinfo-softiec-reply", "a count that includes IEC slots is not a protocol error") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)

      ; Two drives and one SoftwareIEC slot: a count of three in seven bytes.
      [reply] = $03
      [reply] + $01 = $00               ; drive A: 1541, device 8, running
      [reply] + $02 = $08
      [reply] + $03 = $01
      [reply] + $04 = $02               ; drive B: 1581, device 9, stopped
      [reply] + $05 = $09
      [reply] + $06 = $00
      [reply] + $07 = $ff               ; no eighth byte arrived
      [drvinfo_len] = $07
      [result] = $ff
      jsr([t_drvinfo_reply], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK, where the old parser answered ULTIMATE_ERR_PROTOCOL")
      assert([reply] == $02, "the count is the two records that arrived, not the three declared")
      assert(([reply] + $02).b == $08, "drive A's device number is untouched")
      assert(([reply] + $05).b == $09, "and so is drive B's")
      assert(([reply] + $07).b == $ff, "and nothing past the reply was turned into a record")
    }

    test("sdk-drvinfo-reply-limits", "what the parser accepts, and what it still refuses") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)

      ; Both drives and all four IEC slots in use: the largest count there is.
      [reply] = $06
      [drvinfo_len] = $07
      [result] = $ff
      jsr([t_drvinfo_reply], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([reply] == $02, "clamped to the two records the reply carried")

      ; A firmware that does send every record it counts is not clamped.
      [reply] = $06
      [drvinfo_len] = $13               ; CTRL_DRVINFO_BYTES
      [result] = $ff
      jsr([t_drvinfo_reply], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([reply] == $06, "and all six records are reported")

      ; Slots only, with neither drive configured: the count byte on its own.
      [reply] = $02
      [drvinfo_len] = $01
      [result] = $ff
      jsr([t_drvinfo_reply], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK")
      assert([reply] == $00, "no records arrived, so none are reported")

      ; Seven is past every slot the firmware has to report.
      [reply] = $07
      [drvinfo_len] = $07
      [result] = $ff
      jsr([t_drvinfo_reply], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $03, "ULTIMATE_ERR_PROTOCOL")

      ; A length that ends inside a record is not this reply layout.
      [reply] = $02
      [drvinfo_len] = $08
      [result] = $ff
      jsr([t_drvinfo_reply], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $03, "ULTIMATE_ERR_PROTOCOL")
    }

    test("sdk-net-setip", "writing an interface configuration") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [net_iface] = $00
      [reply0] = $c0            ; 192.168.1.64, and a mask and gateway behind it
      [reply1] = $a8
      [reply2] = $01
      [reply3] = $40
      [result] = $ff
      jsr([t_net_setip], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "SET_IPADDR: ULTIMATE_ERR_NOT_SUPPORTED")
    }

    ; --- HTTP request bodies ---
    ;
    ; The simulated Ultimate has no HTTP target, so every one of these is the
    ; older-firmware case. The two argument checks below never reach the wire
    ; and mean the same thing on every machine.

    test("sdk-http-body", "building a request body, on firmware without HTTP") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)

      [body_arg] = $02          ; HTTP_BODY_JSON_OBJECT
      [result] = $ff
      jsr([t_body], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "BODY_CREATE: ULTIMATE_ERR_NOT_SUPPORTED")
      assert([body_arg] == $ff, "and HTTP_BODY_NONE, which is not a handle")

      ; The rest are driven with a handle of zero. Nothing on the far end has
      ; one, so what is being pinned is the command going out and the refusal
      ; coming back.
      [body_arg] = $00
      [reply0] = $6b            ; "key"
      [reply1] = $65
      [reply2] = $79
      [reply3] = $00
      [name2] = $76             ; "val"
      [name2] + $01 = $61
      [name2] + $02 = $6c
      [name2] + $03 = $00
      [val_arg] = $2a           ; 42
      [val_arg] + $01 = $00
      [val_arg] + $02 = $00
      [val_arg] + $03 = $00
      [flag_arg] = $01

      [result] = $ff
      jsr([t_body_string], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "BODY_ADD_STRING")
      [result] = $ff
      jsr([t_body_int], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "BODY_ADD_INT")
      [result] = $ff
      jsr([t_body_bool], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "BODY_ADD_BOOL")
      [result] = $ff
      jsr([t_body_object], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "BODY_ADD_OBJECT")
      [result] = $ff
      jsr([t_body_array], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "BODY_ADD_ARRAY")
      [result] = $ff
      jsr([t_body_up], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "BODY_UP")

      [buf_data] = $01
      [buf_data] + $01 = $02
      [wr_len] = $02
      [wr_len] + $01 = $00
      [result] = $ff
      jsr([t_body_binary], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "BODY_ADD_BINARY")

      [result] = $ff
      jsr([t_body_clear], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "BODY_CLEAR")
      [result] = $ff
      jsr([t_body_free], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $04, "BODY_FREE")
    }

    test("sdk-http-body-rejects-a-bad-format", "a format outside 1 to 4 never reaches the wire") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [body_arg] = $00
      [result] = $ff
      jsr([t_body], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
      assert([body_arg] == $ff, "and no handle was invented")

      [body_arg] = $05
      [result] = $ff
      jsr([t_body], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $05, "ULTIMATE_ERR_INVALID_ARGUMENT")
    }

    test("sdk-mkdir", "a directory is created, seen, and taken away again") {
      jsr([boot], stop_on_rts = true, fail_on_brk = true)
      jsr([t_init], stop_on_rts = true, fail_on_brk = true)
      [ident_buflen] = $40
      [ident_buflen] + $01 = $00

      [reply0] = $2f            ; "/Usb0/data"
      [reply1] = $55
      [reply2] = $73
      [reply3] = $62
      [reply0] + $04 = $30
      [reply0] + $05 = $2f
      [reply0] + $06 = $64
      [reply0] + $07 = $61
      [reply0] + $08 = $74
      [reply0] + $09 = $61
      [reply0] + $0a = $00
      [result] = $ff
      jsr([t_chdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "in the fixture's subdirectory")

      [reply0] = $64            ; "dir.tmp"
      [reply1] = $69
      [reply2] = $72
      [reply3] = $2e
      [reply0] + $04 = $74
      [reply0] + $05 = $6d
      [reply0] + $06 = $70
      [reply0] + $07 = $00
      [result] = $ff
      jsr([t_mkdir], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "CREATE_DIR succeeded")

      [result] = $ff
      jsr([t_stat], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and it is there")
      assert(([finfo] + $0b).b == $10, "DOS_ATTR_DIR, so it is a directory")

      [result] = $ff
      jsr([t_delete], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "and it was taken away again")
    }
  }
}
