; blob.suite - the standalone blob, called through its jump table.
;
; No symbols and no harness: this is exactly what a KickAssembler, Oscar64 or
; BASIC caller sees. If the offsets in this file are wrong, every one of those
; callers is broken, which is why they are written as literals here rather
; than read from a symbol file.
;
; SPDX-License-Identifier: MIT

suites {
  suite("the sdk as a standalone blob") {
    system(c64)
    load("/code/bindings/blob/build/ultimate-7000.bin", address = $7000)

    test("blob-signature", "the blob identifies itself at its base address") {
      assert($7000 == $d5, "'U' in PETSCII")
      assert($7001 == $c3, "'C'")
      assert($7002 == $c9, "'I'")
      assert($7003 == $01, "version 1")
      assert($7004 == $4c, "a jmp at the first entry")
      ; sim6502 requires a test to execute something; jsr into the entry we
      ; just verified rather than adding an unrelated instruction.
      jsr($7004, stop_on_rts = true, fail_on_brk = true)
    }

    test("blob-init", "uci_init through the jump table") {
      a = $ff
      jsr($7004, stop_on_rts = true, fail_on_brk = true)
      assert(a == $00, "ULTIMATE_OK")
    }

    test("blob-present", "uci_present through the jump table") {
      jsr($700d, stop_on_rts = true, fail_on_brk = true)
      assert(a == $01, "the interface is there")
    }

    test("blob-timeout-roundtrip", "set and get the timeout through the table") {
      jsr($7004, stop_on_rts = true, fail_on_brk = true)
      a = $37
      jsr($7013, stop_on_rts = true, fail_on_brk = true)
      a = $00
      jsr($7016, stop_on_rts = true, fail_on_brk = true)
      assert(a == $37, "the budget we set")
    }

    ; The real proof: a whole exchange, driven only through the table and the
    ; caller-facing request block, with no symbols at all.
    test("blob-exec", "a command runs through the table") {
      jsr($7004, stop_on_rts = true, fail_on_brk = true)
      assert(a == $00, "init")

      ; uci_req sits 78 bytes into the SDK's variable block, after the service
      ; layer's own storage. The default VARS is $9F00 - see
      ; bindings/blob/README.md - so the block is at $9F4E.
      ;
      ; **These addresses move whenever the variable block grows.** They did
      ; when the captured status prefix went from four bytes to sixteen, and
      ; the README table is the thing to re-read rather than to guess from.
      ;
      ; **Every byte is written, one byte at a time.** `$9f50 = $0000` stores
      ; the low byte and leaves the high one holding whatever was in RAM,
      ; which is the trap docs/handover.md section 4 names - and with the
      ; variables now outside the loaded image, what was in RAM stopped being
      ; reliably zero and this test started failing differently run to run.

      $9f4e = $01         ; UCI_REQ_TARGET = DOS1
      $9f4f = $f0         ; UCI_REQ_COMMAND = ECHO
      $9f50 = $00         ; UCI_REQ_ARGS
      $9f51 = $00
      $9f52 = $00         ; UCI_REQ_ARGLEN
      $9f53 = $00
      $9f54 = $00         ; UCI_REQ_PAYLOAD
      $9f55 = $00
      $9f56 = $00         ; UCI_REQ_PAYLOADLEN
      $9f57 = $00
      $9f58 = $51         ; UCI_REQ_DATA -> the reply buffer at $7151
      $9f59 = $71
      $9f5a = $00         ; UCI_REQ_DATAMAX = 256
      $9f5b = $01
      $9f5c = $00         ; UCI_REQ_DATALEN
      $9f5d = $00
      $9f5e = $00         ; UCI_REQ_STATUS
      $9f5f = $00
      $9f60 = $00         ; UCI_REQ_STATUSMAX
      $9f61 = $00
      $9f62 = $00         ; UCI_REQ_STATUSLEN
      $9f63 = $00

      jsr($7007, stop_on_rts = true, fail_on_brk = true)
      assert(a == $00, "ULTIMATE_OK")
      assert($9f5c.w == $0002, "two bytes echoed")
      assert($7151 == $01, "target byte")
      assert($7152 == $f0, "command byte")
    }

    ; The parameter-block entries. A blob caller cannot pass a filename in A/X,
    ; so these read the page at $7100 and write their answer back into it -
    ; which is also the only calling convention a BASIC program with POKE and
    ; SYS can express. The offsets are literals here for the same reason the
    ; jump table's are: they are the contract.
    test("blob-load-through-the-parameter-block", "a file, named in the block and loaded by it") {
      jsr($7004, stop_on_rts = true, fail_on_brk = true)
      assert(a == $00, "init")

      ; bp_name at +$29: "big.bin", NUL terminated.
      $7129 = $62
      $712a = $69
      $712b = $67
      $712c = $2e
      $712d = $62
      $712e = $69
      $712f = $6e
      $7130 = $00

      $7103 = $00               ; bp_addr = $4000, well clear of the blob
      $7104 = $40
      $7105 = $00               ; bp_len: no limit, since load takes the
      $7106 = $00               ; length from the file
      $7100 = $ff               ; bp_result, so a call that never ran shows

      $4000 = $ff
      jsr($706d, stop_on_rts = true, fail_on_brk = true)
      assert($7100 == $00, "bp_result is ULTIMATE_OK")
      assert($7107.w == $4256, "bp_end: 598 bytes, 600 less the PRG header")
      assert($4000 == $02, "and the header was consumed, not stored")
    }

    test("blob-reu-through-the-parameter-block", "the expansion's two numbers, out of the block") {
      $df00 = $40               ; REU_STAT_DONE: the sim has RAM here, not a REU

      $7103 = $00               ; bp_addr = $4000
      $7104 = $40
      ; bp_reu is at +$156 of the block and the block is at $7100, so $7256 -
      ; the reply buffer above it is a page long and the offsets carry.
      $7256 = $45               ; bp_reu = $012345
      $7257 = $23
      $7258 = $01
      $7259 = $00
      $725a = $00               ; bp_reulen = 256
      $725b = $01
      $725c = $00
      $725d = $00
      $7100 = $ff

      jsr($7079, stop_on_rts = true, fail_on_brk = true)
      assert($7100 == $00, "bp_result is ULTIMATE_OK")
      assert($df02 == $00, "C64 address low")
      assert($df03 == $40, "...and high")
      assert($df04 == $45, "REU address low")
      assert($df06 == $01, "...and its third byte")
      assert($df08 == $01, "length high: 256")
      assert($df01 == $90, "EXECUTE and NOW, mode 00: C64 to REU")
    }

    ; The DOS service, driven entirely through the block: a caller with no
    ; symbols, no linker and no C runtime, which is every toolchain the blob
    ; exists for. Each entry leaves its answer in bp_result as well as in A.
    test("blob-dos-walk-through-the-parameter-block", "chdir, getpath, opendir, readdir, open, read, close") {
      jsr($7004, stop_on_rts = true, fail_on_brk = true)
      assert(a == $00, "init")

      $7129 = $2f            ; "/Usb0"
      $712a = $55            
      $712b = $73            
      $712c = $62            
      $712d = $30            
      $712e = $00
      $7100 = $ff
      jsr($704f, stop_on_rts = true, fail_on_brk = true)   ; +$4F chdir
      assert($7100 == $00, "chdir: bp_result is ULTIMATE_OK")

      $7151 = $00
      jsr($7052, stop_on_rts = true, fail_on_brk = true)   ; +$52 getpath
      assert($7100 == $00, "getpath succeeded")
      assert($7151 == $2f, "and the path is in bp_reply, starting '/'")

      jsr($7055, stop_on_rts = true, fail_on_brk = true)   ; +$55 opendir
      assert($7100 == $00, "opendir succeeded")

      $7251 = $00
      jsr($7058, stop_on_rts = true, fail_on_brk = true)   ; +$58 readdir
      assert($7100 == $00, "readdir returned an entry")
      assert($7251 == $10, "bp_attrib says DOS_ATTR_DIR")
      assert($7151 == $64, "'d' of data, with the attribute byte lifted off it")

      ; **The walk is finished before anything else is sent.** The firmware is
      ; midway through a reply chain until the last entry has been read, and a
      ; command sent into that times out. Two entries here, so the third call
      ; is the end.
      jsr($7058, stop_on_rts = true, fail_on_brk = true)   ; +$58 readdir
      assert($7100 == $00, "the second entry")
      assert($7151 == $62, "'b' of big.bin")
      jsr($7058, stop_on_rts = true, fail_on_brk = true)   ; +$58 readdir
      assert($7100 == $0a, "ULTIMATE_END: the directory is finished")

      $7129 = $62            ; "big.bin"
      $712a = $69            
      $712b = $67            
      $712c = $2e            
      $712d = $62            
      $712e = $69            
      $712f = $6e            
      $7130 = $00
      $7251 = $01                                          ; bp_attrib: DOS_FA_READ
      jsr($705b, stop_on_rts = true, fail_on_brk = true)   ; +$5B open
      assert($7100 == $00, "open succeeded")

      $7103 = $00                                          ; bp_addr = $4000
      $7104 = $40
      $7105 = $40                                          ; bp_len: ask for 64
      $7106 = $00
      $4000 = $ff
      jsr($7061, stop_on_rts = true, fail_on_brk = true)   ; +$61 read
      assert($7100 == $00, "read succeeded")
      assert($7105 == $40, "bp_len came back as how many arrived")
      assert($4000 == $00, "and big.bin counts up from zero")

      jsr($705e, stop_on_rts = true, fail_on_brk = true)   ; +$5E close
      assert($7100 == $00, "close succeeded")
    }

    ; The write half, and the cleanup that the test data policy in
    ; docs/handover.md section 6 requires: the file is created here, used here,
    ; and deleted here.
    test("blob-write-walk-through-the-parameter-block", "open, write, seek, save, bload, delete") {
      jsr($7004, stop_on_rts = true, fail_on_brk = true)

      $7129 = $2f            ; "/Usb0/data"
      $712a = $55            
      $712b = $73            
      $712c = $62            
      $712d = $30            
      $712e = $2f            
      $712f = $64            
      $7130 = $61            
      $7131 = $74            
      $7132 = $61            
      $7133 = $00
      jsr($704f, stop_on_rts = true, fail_on_brk = true)   ; +$4F chdir
      assert($7100 == $00, "in the fixture's subdirectory")

      $7129 = $62            ; "bl.tmp"
      $712a = $6c            
      $712b = $2e            
      $712c = $74            
      $712d = $6d            
      $712e = $70            
      $712f = $00
      $7251 = $0b                                          ; CREATE_ALWAYS|WRITE|READ
      jsr($705b, stop_on_rts = true, fail_on_brk = true)   ; +$5B open
      assert($7100 == $00, "the file was created")

      $4200 = $de
      $4201 = $ad
      $4202 = $be
      $4203 = $ef
      $7103 = $00                                          ; bp_addr = $4200
      $7104 = $42
      $7105 = $04                                          ; bp_len = 4
      $7106 = $00
      jsr($7064, stop_on_rts = true, fail_on_brk = true)   ; +$64 write
      assert($7100 == $00, "write succeeded")
      jsr($705e, stop_on_rts = true, fail_on_brk = true)   ; +$5E close

      $7251 = $01
      jsr($705b, stop_on_rts = true, fail_on_brk = true)   ; +$5B open, for reading
      assert($7100 == $00, "and it opens again")

      $7252 = $02                                          ; bp_pos = 2
      $7253 = $00
      $7254 = $00
      $7255 = $00
      jsr($7067, stop_on_rts = true, fail_on_brk = true)   ; +$67 seek
      assert($7100 == $00, "seek succeeded")

      $7103 = $00                                          ; bp_addr = $4300
      $7104 = $43
      $7105 = $10                                          ; ask for sixteen
      $7106 = $00
      $4300 = $00
      jsr($7061, stop_on_rts = true, fail_on_brk = true)   ; +$61 read
      assert($7105 == $02, "two bytes left after the seek")
      assert($4300 == $be, "and they are the third and fourth written")
      jsr($705e, stop_on_rts = true, fail_on_brk = true)   ; +$5E close

      ; save writes a region straight out of memory, and bload reads it back
      ; over a wiped buffer so the comparison cannot pass on what was there.
      $7103 = $00                                          ; bp_addr = $4200
      $7104 = $42
      $7105 = $04
      $7106 = $00
      jsr($7073, stop_on_rts = true, fail_on_brk = true)   ; +$73 save
      assert($7100 == $00, "save succeeded")

      $4200 = $00
      $4203 = $00
      $7105 = $04
      $7106 = $00
      jsr($7070, stop_on_rts = true, fail_on_brk = true)   ; +$70 bload
      assert($7100 == $00, "bload succeeded")
      assert($7107.w == $4204, "bp_end: four bytes, ending where they started plus four")
      assert($4200 == $de, "byte for byte")
      assert($4203 == $ef, "all four of them")

      jsr($706a, stop_on_rts = true, fail_on_brk = true)   ; +$6A delete
      assert($7100 == $00, "and the fixture tree is as it was found")
    }

    ; The REU entries. u64sim has RAM at $DF00-$DF0A rather than an expansion,
    ; which is enough to see the block reach the registers, and it does not
    ; implement the DOS REU pair at all - so those two are pinned at the
    ; ULTIMATE_ERR_NOT_SUPPORTED a caller has to handle on any firmware that
    ; answers the same way.
    test("blob-reu-entries", "available, fetch, and the two that go through DOS") {
      $df00 = $40                                          ; REU_STAT_DONE

      jsr($7076, stop_on_rts = true, fail_on_brk = true)   ; +$76 reu_available
      assert(a == $01, "plain RAM answers the probe, as reu.s says it will")

      $7103 = $00                                          ; bp_addr = $4400
      $7104 = $44
      $7256 = $00                                          ; bp_reu = 0
      $7257 = $00
      $7258 = $00
      $7259 = $00
      $725a = $20                                          ; bp_reulen = 32
      $725b = $00
      $725c = $00
      $725d = $00
      $7100 = $ff
      jsr($707c, stop_on_rts = true, fail_on_brk = true)   ; +$7C reu_fetch
      assert($7100 == $00, "fetch reported the transfer done")
      assert($df01 == $91, "EXECUTE and NOW, mode 01: REU to C64")
      assert($df03 == $44, "and the C64 address came out of the block")

      $7100 = $ff
      jsr($707f, stop_on_rts = true, fail_on_brk = true)   ; +$7F reu_load
      assert($7100 == $04, "ULTIMATE_ERR_NOT_SUPPORTED, from this firmware")

      $7100 = $ff
      jsr($7082, stop_on_rts = true, fail_on_brk = true)   ; +$82 reu_save
      assert($7100 == $04, "and the same for reu_save")
    }

    test("blob-legacy-sid-info", "deprecated SID records reach the blob parameter block") {
      jsr($7004, stop_on_rts = true, fail_on_brk = true)
      $7100 = $ff
      $7151 = $ff
      jsr($70b2, stop_on_rts = true, fail_on_brk = true)
      ; u64sim returns its model string for every deprecated GET_HWINFO selector. The SDK
      ; rejects that malformed SID reply and clears the count in bp_reply.
      assert($7100 == $03, "bp_result is ULTIMATE_ERR_PROTOCOL")
      assert($7151 == $00, "the SID count is clear after failure")
    }
  }
}
