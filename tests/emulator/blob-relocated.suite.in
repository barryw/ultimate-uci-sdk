; blob-relocated.suite.in - the blob moved to a different address, then called.
;
; Generated into blob-relocated.suite by tests/emulator/Makefile, which
; substitutes @BLOBSIZE@ with the size of the blob it just built. That number
; used to be written here by hand, at 2860 bytes, and the moment the SDK grew
; past it this suite would have gone on comparing the first 2860 bytes and
; reporting success for a relocation it had never looked at. Adding the palette
; service took the blob to 3060, so it was one commit away from happening.
;
; A relocation table with a missing entry still passes every test that runs the
; blob where it was built. reloc-is-complete catches one by comparing against
; ground truth: it moves the blob from $C000 to $8000 with the runtime
; relocator, then compares the result byte-for-byte against a second blob the
; linker built directly for $8000. Every one of the 86 relocated bytes has to
; match, and so does every byte that must NOT move (the SDK's hardware
; register addresses), which a test that only calls through the moved jump
; table could never catch - a handful of untouched entry points can't exercise
; all 86, and even full coverage wouldn't tell you an address that shouldn't
; move stayed put.
;
; SPDX-License-Identifier: MIT

suites {
  suite("the blob, relocated") {
    system(c64)
    symbols("/code/tests/emulator/relocharness.sym")
    load("/code/tests/emulator/relocharness.prg", strip_header = true)
    load("/code/bindings/blob/build/ultimate-7000.bin", address = $7000)
    ; Ground truth for reloc-is-complete: the same SDK, linked directly for
    ; $6000 instead of relocated there at runtime. Loaded at $2000 - a scratch
    ; address clear of the harness at $0801, of the blob being moved at $7000,
    ; and of where it is moved to - so it just sits there as a reference to
    ; memcmp against, not as anything that gets called.
    load("/code/bindings/blob/build/ultimate-6000.bin", address = $2000)

    test("reloc-init", "the relocated blob still brings the interface up") {
      jsr([t_reloc], stop_on_rts = true, fail_on_brk = true)
      assert($6000 == $d5, "the signature moved with it")
      assert($6004 == $4c, "and so did the jump table")

      jsr([t_call_init], stop_on_rts = true, fail_on_brk = true)
      assert([result] == $00, "ULTIMATE_OK from $6000")
    }

    ; The completeness gate: relocate $7000 down to $6000 at runtime, then
    ; compare it byte-for-byte against a blob the linker built for $6000
    ; directly. A missing table entry leaves a stale byte pointing back into
    ; $70xx; a wrongly-included entry shifts a byte that should have held
    ; still (e.g. the SDK's $DF1B-$DF1F hardware register addresses). Either
    ; way the two blobs stop matching, so this catches both failure modes -
    ; not just the ones a call graph happens to reach.
    test("reloc-is-complete", "the relocated blob matches a from-scratch $6000 build byte-for-byte") {
      jsr([t_reloc], stop_on_rts = true, fail_on_brk = true)
      assert(memcmp($6000, $2000, @BLOBSIZE@), "runtime relocation output differs from the $6000 linker build")
    }
  }
}
